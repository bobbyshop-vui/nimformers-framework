# Graph-model helpers. All arithmetic is emitted through session_vm.
# One lane owns a norm row or attention head; no cross-group synchronization.
import nim "std/[tables, strutils, math]"
import nim "session_vm"
import nim "backend"
import "fir_types.bybylang"

function firGraphBindings(model: FirProgram, separateRawWeights: bool = false): FirBindings
    var offset = 0
    result.separateRawWeights = separateRawWeights
    var slots = false
    for name, kernel in model.kernels:
        if kernel.layout == "slots":
            slots = true
    # Allocate small weight vectors in memF32 alongside graph activations.
    var names: seq[string]
    for name, buffer in model.buffers:
        if buffer.viewOf.len > 0:
            continue
        if separateRawWeights and firResidentRaw(model, name):
            result.memory[name] = 0
            continue
        if buffer.kind != "weight" or buffer.dims.len == 1:
            names.add(name)
        elif model.layout == "script" and buffer.dtype == "f32" and buffer.dims.len != 2:
            names.add(name)
        elif model.layout == "script" and (buffer.dtype in ["f32a", "fp4km", "raw"] or firQ4bGroup(buffer.dtype) > 0):
            names.add(name)
    # Sorting is unnecessary for correctness: every program uses this same map.
    for name in names:
        let buffer = model.buffers[name]
        if slots:
            # Preserve vector alignment when relocating whole recorded buffers.
            offset = ((offset+63) div 64)*64
        result.memory[name] = offset
        offset += buffer.elements * (if buffer.perLayer or buffer.tensorName.contains("{i}"): model.symbols["layers"] else: 1)
    for name, buffer in model.buffers:
        if buffer.viewOf.len > 0:
            if not result.memory.hasKey(buffer.viewOf):
                raise newException(ValueError, "FIR view needs arena base: " & name)
            result.memory[name] = result.memory[buffer.viewOf] + buffer.viewOffset
    result.memoryFloats = offset
    result.T = 1

function fgLinearF32(args: FirExtArgs): seq[float32]
    beMatmul(args.backend, args.values, 1, args.inDim, args.weights, args.inDim, args.outDim)

function fgResidentQ4(args: FirExtArgs): seq[float32]
    beResidentLinearQ4(args.backend, args.values, args.residentQ4, 1)

function fgEmbedding(args: FirExtArgs): seq[float32]
    beEmbeddingLookup(args.backend, args.weights, args.indices, args.vocab, args.outDim)

function fgLmHead(args: FirExtArgs): seq[float32]
    # Weight [out,in] shared with the embedding; backend NT avoids transposing or duplicating it.
    let be = args.backend.kind.toByby()
    if not sessionBegin(be):
        raise newException(ValueError, "FIR graph lm_head sessionBegin failed")
    var x = sessionUpload(be, args.values)
    var w = sessionUpload(be, args.weights)
    var y = sessionAllocScratch(be, args.outDim)
    try:
        let ok = sessionMatmulNT(be, x, w, y, 1, args.inDim, args.outDim)
        let ended = sessionEnd(be)
        if not ok or not ended:
            raise newException(ValueError, "FIR graph lm_head backend matmul failed")
        result = sessionRead(be, y, args.outDim)
    finally:
        sessionFree(be, x)
        sessionFree(be, w)
        sessionFree(be, y)

function firRegisterGraph(registry: var FirRegistry)
    # fir.linear: y = x * W with W [in,out] ([in,out] layout). The weight dtype
    # selects the backend kernel: q4 -> resident Q4 GEMV, f32 -> F32 matmul.
    registry.external["fir.linear"] = FirExtBinding(call: fgLinearF32, backendSymbol: "backend.sessionMatmulQ4|backend.sessionMatmul", inputs: 2, outputs: 1)
    registry.external["fir.embedding"] = FirExtBinding(call: fgEmbedding, backendSymbol: "backend.beEmbeddingLookup", inputs: 2, outputs: 1)
    registry.external["fir.linear_t"] = FirExtBinding(call: fgLmHead, backendSymbol: "backend.sessionMatmulNT", inputs: 2, outputs: 1)

function fgValidateExternal(model: FirProgram, node: FirNode)
    let ins = node.inputs.splitWhitespace()
    let outs = node.outputs.splitWhitespace()
    let w = model.buffers[ins[1]]
    let x = model.buffers[ins[0]]
    let y = model.buffers[outs[0]]
    let dtypeOk = (node.op == "fir.linear" and w.dtype in ["q4", "f32"]) or (node.op == "fir.linear_t" and w.dtype in ["q4t", "f32"]) or (node.op == "fir.embedding" and w.dtype == "f32")
    if w.kind != "weight" or not dtypeOk or w.dims.len != 2 or x.kind == "weight" or y.kind == "weight":
        raise newException(ValueError, "FIR graph external requires matching weight dtype and f32 activations: " & node.name)
    # Several rows: w is [K,N] (fir.linear) or [N,K] (fir.linear_t); x holds M*K and y M*N floats.
    var expected = if node.op == "fir.linear": @[x.elements, y.elements] else: @[y.elements, x.elements]
    if node.op != "fir.embedding" and (w.dtype == "f32" or w.dtype == "q4"):
        let inner = if node.op == "fir.linear": w.dims[0] else: w.dims[1]
        if inner > 0 and x.elements mod inner == 0:
            let rows = x.elements div inner
            if y.elements mod rows == 0:
                expected = if node.op == "fir.linear": @[inner, y.elements div rows] else: @[y.elements div rows, inner]
    if node.op == "fir.embedding":
        let rows = if node.phase.len > 0: model.phases[node.phase] else: 1
        if x.elements != 1 or w.dims[1]*rows != y.elements:
            raise newException(ValueError, "FIR graph embedding shape mismatch: " & node.name)
    elif w.dims != expected:
        raise newException(ValueError, "FIR graph matrix shape mismatch: " & node.name)
