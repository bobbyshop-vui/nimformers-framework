import nim "std/[os, strutils, tables, json, math]"
import "fir_types.bybylang"

function firEvalExpr(expr: string, syms: Table[string, int]): int
    let s = expr.strip()
    if s.len == 0:
        return 0
    if syms.hasKey(s):
        return syms[s]
    # FIR v1 expressions are deliberately limited to integer +, -, *, and /.
    var depth = 0
    for i in countdown(s.high, 0):
        if s[i] == ')':
            inc depth
        elif s[i] == '(':
            dec depth
        elif depth == 0 and s[i] in ['+', '-'] and i > 0:
            let left = firEvalExpr(s[0 ..< i], syms)
            let right = firEvalExpr(s[i + 1 .. ^1], syms)
            return if s[i] == '+': left + right else: left - right
    depth = 0
    for i in countdown(s.high, 0):
        if s[i] == ')':
            inc depth
        elif s[i] == '(':
            dec depth
        elif depth == 0 and s[i] in ['*', '/']:
            let left = firEvalExpr(s[0 ..< i], syms)
            let right = firEvalExpr(s[i + 1 .. ^1], syms)
            if s[i] == '*':
                return left * right
            if right == 0:
                raise newException(ValueError, "division by zero in FIR expression: " & s)
            return left div right
    if s[0] == '(' and s[^1] == ')':
        return firEvalExpr(s[1 .. ^2], syms)
    try:
        return parseInt(s)
    except ValueError:
        raise newException(ValueError, "unknown FIR symbol or invalid expression: " & s)

function firDeclaredRuntime(path: string): string
    ## The `runtime` declaration of a FIR file ("" when absent), without parsing the rest.
    for raw in readFile(path).splitLines():
        let w = raw.split('#', 1)[0].strip().splitWhitespace()
        if w.len == 2 and w[0] == "runtime":
            return w[1]

function firRoleBuffer(graph: FirProgram, role: string): string
    ## Name of the buffer the model file declared with input:ROLE or output:ROLE.
    for name, buffer in graph.buffers:
        if buffer.role == role:
            return name
    raise newException(ValueError, "FIR graph declares no buffer with role '" & role & "' (use input:token, input:position, output:logits)")

function firParse(path: string, configOverride: string = ""): FirProgram
    if not fileExists(path):
        raise newException(IOError, "FIR file not found: " & path)
    result.sourcePath = path
    result.layout = "classic"
    var cfgPath = ""
    var rawLines = readFile(path).splitLines()
    # Resolve the final layout outside kernel bodies before gated declarations.
    # Leave validation in the original pass to preserve classic error ordering.
    var headerLayout = "classic"
    var headerKernel = false
    for i, raw in rawLines:
        let line = raw.split('#', 1)[0].strip()
        let w = line.splitWhitespace()
        if w.len > 0:
            if w[0] == "kernel":
                headerKernel = true
            elif w[0] == "endkernel":
                headerKernel = false
            elif not headerKernel and w.len == 2 and w[0] == "layout" and w[1] in ["classic", "script"]:
                headerLayout = w[1]
        if w.len >= 2 and w[0] == "config":
            cfgPath = parentDir(path) / w[1]
    if cfgPath.len == 0:
        cfgPath = parentDir(path) / "config.json"
    if configOverride.len > 0:
        cfgPath = configOverride
    result.configPath = cfgPath
    let cfg = parseFile(cfgPath)
    result.symbols = initTable[string, int]()
    if not cfg.hasKey("ssm_cfg"):
        # Generic graph models: every positive integer config key is a symbol;
        # the model file adds aliases with `sym` and checks with `require`.
        for key, value in cfg:
            if value.kind == JInt and value.getInt() > 0:
                result.symbols[key] = value.getInt()
    else:
        let ssm = cfg["ssm_cfg"]
        let hidden = cfg["d_model"].getInt()
        let inter = cfg{"d_intermediate"}.getInt(hidden * ssm{"expand"}.getInt(2))
        let layers = cfg["n_layer"].getInt()
        let vocab = cfg["vocab_size"].getInt()
        let dstate = ssm["d_state"].getInt()
        let headdim = ssm["headdim"].getInt()
        if min(hidden, min(inter, min(layers, min(vocab, min(dstate, headdim))))) <= 0 or inter mod headdim != 0:
            raise newException(ValueError, "FIR config dimensions must be positive; inter must be divisible by headdim")
        if ssm{"ngroups"}.getInt(1) != 1 or ssm{"is_mimo"}.getBool(false) or ssm{"rope_fraction"}.getFloat(0.5) != 0.5 or dstate mod 4 != 0 or dstate > 256:
            raise newException(ValueError, "FIR Mamba-3 kernels require SISO, ngroups=1, rope_fraction=0.5, dstate divisible by 4 and <=256")
        for (k, v) in [("hidden", hidden), ("inter", inter), ("layers", layers), ("vocab", vocab), ("dstate", dstate), ("headdim", headdim), ("nheads", inter div headdim), ("rope", dstate div 4)]:
            result.symbols[k] = v
    result.epsilon = cfg{"layer_norm_epsilon"}.getFloat(1e-5).float32
    if result.epsilon <= 0 or classify(result.epsilon) in {fcNan, fcInf, fcNegInf}:
        raise newException(ValueError, "FIR epsilon must be positive and finite")
    var inRepeat = false
    var sawHeader = false
    var lineNo = 0
    var openKernel = ""
    var currentPhase = ""
    var sawScriptAbi = false
    result.kernels = initTable[string, FirKernelDef]()
    for raw in rawLines:
        inc lineNo
        let clean = raw.split('#', 1)[0].strip()
        if clean.len == 0:
            continue
        let w = clean.splitWhitespace()
        if openKernel.len > 0 and w[0] != "endkernel":
            # Kernel body: one session_vm emit* call per line, mnemonic first.
            result.kernels[openKernel].body.add(FirKernelLine(mnemonic: w[0].toLowerAscii(), args: w[1 .. ^1], line: lineNo))
            continue
        case w[0]
        of "fir":
            if sawHeader or w.len != 2 or w[1] != "1":
                raise newException(ValueError, "FIR line " & $lineNo & ": expected 'fir 1'")
            sawHeader = true
        of "model":
            if w.len >= 2:
                result.model = w[1]
        of "config": discard
        of "runtime":
            if w.len != 2 or w[1] != "graph":
                raise newException(ValueError, "FIR line " & $lineNo & ": runtime must be 'graph'")
            result.runtime = w[1]
        of "layout":
            if w.len != 2 or w[1] notin ["classic", "script"]:
                raise newException(ValueError, "FIR line " & $lineNo & ": layout must be 'classic' or 'script'")
            result.layout = w[1]
        of "script_abi":
            if headerLayout != "script":
                raise newException(ValueError, "FIR line " & $lineNo & ": unknown declaration 'script_abi'")
            if sawScriptAbi or w.len != 2:
                raise newException(ValueError, "FIR line " & $lineNo & ": expected one 'script_abi 1' directive")
            if w[1] != $FirScriptAbi:
                raise newException(ValueError, "FIR line " & $lineNo & ": unsupported script_abi " & w[1] & "; runner supports 1")
            result.scriptAbi = FirScriptAbi
            sawScriptAbi = true
        of "prefix":
            # Optional tensor-name prefixes tried after the plain name (e.g. "transformer.").
            result.prefixes.add(w[1 .. ^1])
        of "epsilon":
            if w.len != 2:
                raise newException(ValueError, "FIR line " & $lineNo & ": epsilon takes one config key")
            result.epsilon = cfg{w[1]}.getFloat(0.0).float32
            if result.epsilon <= 0 or classify(result.epsilon) in {fcNan, fcInf, fcNegInf}:
                raise newException(ValueError, "FIR epsilon must be positive and finite")
        of "require":
            # require config KEY VALUE : a config value that is present must equal VALUE (absent passes).
            # require sym EXPR = EXPR  : integer expressions over the symbols must be equal.
            if headerLayout == "script" and w.len >= 2 and w[1] == "feature":
                if w.len != 3:
                    raise newException(ValueError, "FIR line " & $lineNo & ": expected 'require feature NAME'")
                if w[2] notin FirScriptFeatures:
                    raise newException(ValueError, "FIR line " & $lineNo & ": unsupported required feature: " & w[2])
                result.requiredFeatures.add(w[2])
            elif w.len >= 4 and w[1] == "config":
                let node = cfg{w[2]}
                let actual = if node.isNil or node.kind == JNull: "" elif node.kind == JString: node.getStr() else: $node
                if actual.len > 0 and actual != w[3]:
                    raise newException(ValueError, "FIR line " & $lineNo & ": config " & w[2] & " is " & actual & ", model requires " & w[3])
            elif w.len >= 5 and w[1] == "sym" and w.find("=") > 2:
                let eq = w.find("=")
                if firEvalExpr(w[2 ..< eq].join(""), result.symbols) != firEvalExpr(w[eq + 1 .. ^1].join(""), result.symbols):
                    raise newException(ValueError, "FIR line " & $lineNo & ": requirement failed: " & w[2 .. ^1].join(" "))
            else:
                raise newException(ValueError, "FIR line " & $lineNo & ": malformed require")
        of "sym":
            if w.len < 4 or w[2] != "=":
                raise newException(ValueError, "FIR line " & $lineNo & ": malformed symbol")
            result.symbols[w[1]] = firEvalExpr(w[3 .. ^1].join(""), result.symbols)
        of "buf":
            if w.len < 4:
                raise newException(ValueError, "FIR line " & $lineNo & ": malformed buffer")
            var b = FirBuffer(name: w[1], dtype: w[2], shape: w[3])
            b.elements = firEvalExpr(w[3], result.symbols)
            b.dims = @[b.elements]
            if w.len > 4:
                for tokenIndex in 4 ..< w.len:
                    let token = w[tokenIndex]
                    if token == "per_layer":
                        b.perLayer = true
                    elif token == "tensor":
                        b.kind = "tensor"
                    elif token.startsWith("input:") or token.startsWith("output:"):
                        # Runtime I/O contract: input:token, input:position, output:logits.
                        b.role = token.split(':', 1)[1]
            if b.dtype != "f32" or b.elements <= 0 or result.buffers.hasKey(b.name):
                raise newException(ValueError, "FIR line " & $lineNo & ": invalid or duplicate buffer " & b.name)
            result.buffers[b.name] = b
        of "weight":
            if w.len < 6:
                raise newException(ValueError, "FIR line " & $lineNo & ": malformed weight")
            var b = FirBuffer(name: w[1], dtype: w[2], shape: w[^1], kind: "weight", tensorName: w[3])
            if w[4] != "tensor" or not b.shape.startsWith("[") or not b.shape.endsWith("]"):
                raise newException(ValueError, "FIR line " & $lineNo & ": invalid weight shape")
            b.elements = 1
            for dim in b.shape[1 .. ^2].split(','):
                let size = firEvalExpr(dim, result.symbols)
                if size <= 0:
                    raise newException(ValueError, "FIR weight dimensions must be positive")
                b.elements *= size
                b.dims.add(size)
            # Script-only dtypes: q4t (resident Q4, [out,in]), f32a (arena resident matrix) and
            # q4b (packed Q4 [out,in] stored in the arena: nibble bytes, then scales, then zeros).
            let q4bGroup = firQ4bGroup(b.dtype)
            let scriptDtype = b.dtype in ["q4t", "f32a", "fp4km", "raw"] or q4bGroup > 0
            if b.dtype == "fp4km":
                if b.dims.len != 2 or b.dims[1] mod 32 != 0:
                    raise newException(ValueError, "FIR fp4km weight needs a 2-D [out,in] shape with in divisible by 32: " & b.name)
                b.elements = firFp4kmWords(b.dims[0], b.dims[1])
            if q4bGroup > 0:
                if b.dims.len != 2:
                    raise newException(ValueError, "FIR q4b weight needs a 2-D [out,in] shape: " & b.name)
                let bytesPerRow = (b.dims[1] + 1) div 2
                let groups = (b.dims[1] + q4bGroup - 1) div q4bGroup
                b.elements = (b.dims[0]*bytesPerRow + 3) div 4 + 2*b.dims[0]*groups
            if result.buffers.hasKey(b.name) or (b.dtype notin ["f32", "q4", "q4t", "f32a", "fp4km", "raw"] and q4bGroup == 0) or (scriptDtype and headerLayout != "script"):
                raise newException(ValueError, "FIR duplicate weight or unsupported dtype: " & b.name)
            result.buffers[b.name] = b
        of "view":
            # view NAME BASE OFFSET COUNT; offsets/counts are float words.
            if w.len < 5 or w.len > 6 or result.buffers.hasKey(w[1]) or not result.buffers.hasKey(w[2]):
                raise newException(ValueError, "FIR invalid view declaration")
            let base = result.buffers[w[2]]
            let offset = firEvalExpr(w[3], result.symbols)
            let count = firEvalExpr(w[4], result.symbols)
            if base.viewOf.len > 0 or offset < 0 or count <= 0 or offset > base.elements-count:
                raise newException(ValueError, "FIR view outside base buffer: " & w[1])
            result.buffers[w[1]] = FirBuffer(name: w[1], dtype: "f32", elements: count, dims: @[count], viewOf: w[2], viewOffset: offset)
            if w.len == 6:
                if not w[5].startsWith("output:") and not w[5].startsWith("input:"):
                    raise newException(ValueError, "FIR invalid view role")
                result.buffers[w[1]].role = w[5].split(':', 1)[1]
        of "init":
            # init NAME FILE BYTE_OFFSET BYTE_COUNT; 'checkpoint' means the selected weights file.
            if w.len notin [5, 6] or not result.buffers.hasKey(w[1]):
                raise newException(ValueError, "FIR invalid init declaration")
            var b = result.buffers[w[1]]
            b.initFile = w[2]
            b.initOffset = parseInt(w[3])
            b.initBytes = parseInt(w[4])
            if w.len == 6:
                b.initFingerprint = w[5]
            if b.viewOf.len > 0 or b.initOffset < 0 or b.initBytes <= 0 or b.initBytes > b.elements*4:
                raise newException(ValueError, "FIR invalid init range: " & b.name)
            result.buffers[w[1]] = b
        of "initwords":
            if w.len < 3 or not result.buffers.hasKey(w[1]):
                raise newException(ValueError, "FIR invalid initwords declaration")
            if w.len-2 != result.buffers[w[1]].elements:
                raise newException(ValueError, "FIR initwords size mismatch")
            for word in w[2 .. ^1]:
                if word.len != 8 or not word.allCharsInSet(HexDigits):
                    raise newException(ValueError, "FIR invalid initializer word")
                result.buffers[w[1]].initialWords.add(uint32(parseHexInt(word)))
        of "repeat":
            if inRepeat or w.len != 2 or w[1] != "layers":
                raise newException(ValueError, "FIR supports one layer repeat scope")
            inRepeat = true
        of "endrepeat":
            if not inRepeat:
                raise newException(ValueError, "FIR unexpected endrepeat")
            inRepeat = false
        of "kernel":
            # kernel NAME in=N out=M threads=EXPR tg=EXPR tgbytes=EXPR [size=a,b,c]
            if inRepeat or w.len < 2 or result.kernels.hasKey(w[1]):
                raise newException(ValueError, "FIR line " & $lineNo & ": invalid or duplicate kernel")
            var def = FirKernelDef(name: w[1], threads: "1", tg: "1", tgBytes: "16", line: lineNo)
            for field in w[2 .. ^1]:
                let kv = field.split('=', 1)
                if kv.len != 2:
                    raise newException(ValueError, "FIR line " & $lineNo & ": kernel option must be key=value")
                case kv[0]
                of "in": def.ins = parseInt(kv[1])
                of "out": def.outs = parseInt(kv[1])
                of "threads": def.threads = kv[1]
                of "tg": def.tg = kv[1]
                of "tgbytes": def.tgBytes = kv[1]
                of "layout":
                    if kv[1] != "slots":
                        raise newException(ValueError, "FIR unsupported kernel layout: " & kv[1])
                    def.layout = kv[1]
                of "slots": def.slots = kv[1].split(',')
                of "tag":
                    # Metadata only: op identity such as aten::linear or aten::add+aten::gelu.
                    var tagOk = kv[1].len > 0 and kv[1].len <= 120
                    for ch in kv[1]:
                        if not (ch.isAlphaNumeric or ch == '_' or ch == ':' or ch == '+' or ch == '.'):
                            tagOk = false
                    if not tagOk:
                        raise newException(ValueError, "FIR line " & $lineNo & ": invalid kernel tag")
                    def.tag = kv[1]
                of "size": def.sizeEq = kv[1].split(',')
                of "expect": def.expects = kv[1].split(',')
                else:
                    raise newException(ValueError, "FIR line " & $lineNo & ": unknown kernel option " & kv[0])
            result.kernels[w[1]] = def
            openKernel = w[1]
        of "endkernel":
            if openKernel.len == 0:
                raise newException(ValueError, "FIR line " & $lineNo & ": unexpected endkernel")
            openKernel = ""
        of "phase":
            if w.len < 2:
                raise newException(ValueError, "FIR line " & $lineNo & ": phase needs a name ('phase NAME rows=N' or 'phase decode')")
            if w[1] != "decode":
                if w.len < 3 or w.len > 4 or not w[2].startsWith("rows=") or (w.len == 4 and not w[3].startsWith("logits=")):
                    raise newException(ValueError, "FIR line " & $lineNo & ": expected 'phase NAME rows=N [logits=BUFFER]'")
                let rows = parseInt(w[2][5 .. ^1])
                if rows < 2:
                    raise newException(ValueError, "FIR line " & $lineNo & ": phase rows must be at least 2")
                if result.phases.hasKey(w[1]):
                    raise newException(ValueError, "FIR line " & $lineNo & ": duplicate phase " & w[1])
                result.phases[w[1]] = rows
                if w.len == 4:
                    result.phaseLogits[w[1]] = w[3][7 .. ^1]
                result.phaseOrder.add(w[1])
                currentPhase = w[1]
            else:
                if w.len != 2:
                    raise newException(ValueError, "FIR line " & $lineNo & ": phase decode takes no arguments")
                currentPhase = ""
        of "node":
            if w.len < 4:
                raise newException(ValueError, "FIR line " & $lineNo & ": malformed node")
            var n = FirNode(name: w[1], kind: w[2], op: w[3], line: lineNo, perLayer: inRepeat, phase: currentPhase)
            let arrow = w.find("->")
            if arrow < 4:
                raise newException(ValueError, "FIR line " & $lineNo & ": node requires inputs -> outputs")
            n.inputs = w[4 ..< arrow].join(" ")
            n.outputs = if arrow < w.high: w[arrow + 1 .. ^1].join(" ") else: ""
            for previous in result.nodes:
                if previous.name == n.name:
                    raise newException(ValueError, "FIR duplicate node: " & n.name)
            result.nodes.add(n)
        else:
            raise newException(ValueError, "FIR line " & $lineNo & ": unknown declaration '" & w[0] & "'")
    if not sawHeader or result.model.len == 0 or inRepeat or openKernel.len > 0:
        raise newException(ValueError, "FIR requires a version, model, and closed repeat scopes")
    firCheckScriptContract(result)
