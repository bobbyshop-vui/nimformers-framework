# Thin FIR scheduler: framework resident linears and session_vm programs share
# one session per token. No host activation/KV staging and no FIR interpreter.
import nim "std/[tables, strutils, algorithm]"
import nim "backend"
import nim "quant"
import nim "customfloat"
import nim "session_vm"
import nim "session_vm_dispatch"
import nim "jit_vm"
import nim "vendor/bybylang/gpubackend"
import nim "vendor/bybylang/backends/cpu/cpu_backend"
import nim "vendor/bybylang/backends/cpu/cpu_jit"
import "fir_types.bybylang"
import "fir_parse.bybylang"
import "fir_exec.bybylang"
import "fir_graph_kernels.bybylang"
import "fir_data.bybylang"
import "../io/safetensors.bybylang"
import nim "vendor/bybylang/probe_weights"
import nim "vendor/bybylang/mapped_file as firMappedFile"
import nim "std/os"
import nim "std/times"

type
  FgStagePort* = object
    name*: string
    offset*, elements*: int
    reads*, writes*: bool
  FgResidentProgram* = object
    kernel*: FirKernel
    name*, source*: string
    cpuFn*: pointer                 ## compiled CPU function (nil = interpret the bytecode)
    stage*: seq[FgStagePort]        ## arena-layout kernel in a handle graph: ports staged contiguously
    metaOffset*: int                ## position-independent kernel: float offset of this node's address table in the arena (-1: none)
    coopTiles*: seq[int]            ## Q4 Tensor Core micro-kernel: row tiles built for this node (chosen per dispatch)
    coopNames*, coopSources*: seq[string]
    gemvRows*: int                  ## Q4 subgroup GEMV micro-kernel: output rows per 32 invocations (0: not one)
  FirGraph* = object
    graph*: FirProgram
    registry*: FirRegistry
    bindings*: FirBindings
    arena*, linearInput*, linearOutput*, logitsReadback*: SessionHandle
    scratchA*, scratchB*, scratchC*: SessionHandle
    handles*: seq[SessionHandle]
    handleIndex*: Table[string, int]
    useHandles*: bool
    nativeQ4*: bool                 ## BYBY_FIR_Q4_BACKEND=native: resident Q4 nodes dispatch through sessionMatmulQ4 instead of their lifted kernel (a diagnostic switch).
    checkpointMap*: firMappedFile.MappedReadOnlyFile ## Keeps mapped Q4 checkpoint bytes alive.
    fp32*: Table[string, SessionHandle]
    rawWeights*: Table[string, SessionHandle]
    rawPools*: seq[SessionHandle]       # GPU backends: raw weights packed into a few large buffers
    rawBase*: Table[string, int]        # float offset of a packed raw weight inside its pool
    rawPlan*: seq[seq[string]]          # members of each pool, in packing order
    q4*: Table[string, ResidentWeightHandle]
    programs*: Table[string, FgResidentProgram]
    backend*: Backend
    position*, dispatched*, sessions*, logitsReads*: int
    failed*: bool
    checkpoint*: string
    initialState*: seq[tuple[offset: int, name: string]]
    chunk*: seq[int]                ## token ids of the multi-row phase being encoded
    activeRows*: int                ## > 0: a partial phase run over this many rows (fewer than declared)
    metaWrites*: seq[tuple[offset: int, value: float32]]   ## address tables of the position-independent kernels
    phaseReadback*: SessionHandle
    stage*: SessionHandle
    stageFloats*: int
    profTime*: Table[string, float]     ## BYBY_FIR_PROFILE=2: wall seconds per "phase kernel"
    profCount*: Table[string, int]
    stepEncodeSeconds*, stepWaitSeconds*, stepReadSeconds*: float   ## BYBY_FIR_PROFILE=1: decode step totals
    stepSeconds*: float                       ## measured at warm-up: one decode step
    phaseBlockSeconds*: Table[string, float]  ## measured at warm-up: one row block of a partial phase
    phaseBlockRows*: Table[string, int]       ## rows one block of that phase covers (largest rows=B of its kernels)
    stepProfiled*: int
    computeUnits*: int                        ## SM/CU count of the device (0: unknown); sizes Q4 Tensor Core tiles
    coopForcedRows*: int                      ## BYBY_FIR_Q4_COOP_ROWS: fixed Q4 Tensor Core row tile (0: per dispatch)
    coopPerUnit*: int                         ## BYBY_FIR_Q4_COOP_WG_PER_UNIT: workgroups each SM/CU should get
    coopFragments*: int                       ## 16-column fragments per subgroup of the Q4 Tensor Core shader (1 with 32-wide subgroups)
    gemvRows*: int                            ## BYBY_FIR_Q4_GEMV_ROWS: output rows per subgroup of the Q4 GEMV micro-kernel
    gemvSubgroupSum*: bool                    ## Q4 GEMV micro-kernel sums with subgroupAdd (32-wide subgroups guaranteed)

function fgTensorName(buffer: FirBuffer, layer: int): string
    buffer.tensorName.replace("{i}", $layer)

function fgResidentQ4HandleKey(name: string, layer: int): string
    "@resident_q4/" & name & "/" & $layer

function fgNodeKey(node: FirNode, layer: int): string
    node.name & ":" & $(if node.perLayer: layer else: -1)

function firF32Weights(graph: FirProgram): FirProgram
    # Copy value types so the caller's Q4 graph remains usable.
    result = graph
    for name, buffer in result.buffers.mpairs:
        if buffer.dtype in ["q4", "q4t"]:
            buffer.dtype = "f32"

function fgLayerBindings(model: FirGraph, layer: int): FirBindings
    result = model.bindings
    for name, buffer in model.graph.buffers:
        if buffer.perLayer or buffer.tensorName.contains("{i}"):
            if result.memory.hasKey(name):
                result.memory[name] += layer*buffer.elements

function fgKernelTag(name: string): string
    ## ATen identity of the kernels shipped with the graph examples. A kernel
    ## defined by the model may declare its own tag; this table is the fallback.
    case name
    of "g2.add", "script.add": return "aten::add"
    of "g2.gelu_new": return "aten::gelu"
    of "g2.layernorm": return "aten::native_layer_norm"
    of "g2.attn_decode", "script.attention": return "aten::scaled_dot_product_attention"
    of "script.rmsnorm": return "aten::rms_norm"
    of "script.add_rmsnorm": return "aten::add+aten::rms_norm"
    of "script.silu_mul": return "aten::silu+aten::mul"
    of "script.conv_step": return "aten::conv1d"
    of "script.ssm_step": return "fir::ssm_step"
    else: return "fir::" & name

function fgNodeTag(model: FirGraph, node: FirNode, layer: int): string
    if node.kind == "session":
        let colon = node.op.find(':')
        let name = if colon >= 0: node.op[0 ..< colon] else: node.op
        if name == "sessionRmsnormEnc":
            return "aten::rms_norm"
        if name == "sessionCopyInto":
            return "aten::copy_"
        let eq = node.op.find("op=")
        if eq >= 0:
            let rest = node.op[eq+3 .. ^1]
            let comma = rest.find(',')
            if comma >= 0:
                return "aten::" & rest[0 ..< comma]
            return "aten::" & rest
        return "fir::" & name
    if node.kind == "ext":
        case node.op
        of "fir.embedding": return "aten::embedding"
        of "fir.linear", "fir.linear_t": return "aten::linear"
        else: return "fir::" & node.op
    if model.programs.hasKey(fgNodeKey(node, layer)):
        let tag = model.programs[fgNodeKey(node, layer)].kernel.tag
        if tag.len > 0:
            return tag
    if model.graph.kernels.hasKey(node.op) and model.graph.kernels[node.op].tag.len > 0:
        return model.graph.kernels[node.op].tag
    return fgKernelTag(node.op)

function fgNativeQ4Weight(graph: FirProgram, node: FirNode): string
    ## A q4r weight is consumed by a generated slot kernel. With the native
    ## runner selector, the same node can use the backend's resident Q4 plan.
    if node.kind != "micro" or not graph.kernels.hasKey(node.op) or graph.kernels[node.op].layout != "slots":
        return ""
    for name in node.inputs.splitWhitespace():
        if graph.buffers.hasKey(name) and firResidentQ4(graph, name):
            return name
    return ""

function fgNativeQ4Tensor(graph: FirProgram, name: string): bool
    for node in graph.nodes:
        if fgNativeQ4Weight(graph, node) == name:
            return true

function fgTuneNativeQ4(model: FirGraph, weight: ResidentWeightHandle)
    if model.nativeQ4:
        discard residentPrepareQ4(weight, 1)
        discard residentPrepareQ4(weight, 8)
        discard residentPrepareQ4(weight, 256)

function fgProbeTensor(model: FirGraph, name: string, layer: int): string
    ## Buffer reference of one node port: resident weight, arena weight or arena
    ## activation.
    let buffer = model.graph.buffers[name]
    let base = if buffer.viewOf.len > 0: buffer.viewOf else: name
    if model.rawWeights.hasKey(base):
        let packed = if model.rawBase.hasKey(base): model.rawBase[base] else: 0
        return probeHandleRef(model.rawWeights[base], packed + buffer.viewOffset, buffer.elements)
    if model.handleIndex.hasKey(base):
        return probeHandleRef(model.handles[model.handleIndex[base]], buffer.viewOffset, buffer.elements)
    if firResidentQ4(model.graph, base):
        let tensor = fgTensorName(buffer, layer)
        if model.nativeQ4 and model.q4.hasKey(tensor):
            return probeWeightRef(model.q4[tensor])
        let key = fgResidentQ4HandleKey(base, layer)
        if not model.handleIndex.hasKey(key):
            raise newException(ValueError, "FIR resident Q4 tensor handle is missing: " & name)
        return probeHandleRef(model.handles[model.handleIndex[key]], 0, buffer.elements)
    let bindings = fgLayerBindings(model, layer)
    if buffer.kind == "weight":
        let tensor = fgTensorName(buffer, layer)
        if buffer.dtype in ["q4", "q4t"] and model.q4.hasKey(tensor):
            return probeWeightRef(model.q4[tensor])
        if model.fp32.hasKey(tensor):
            return probeHandleRef(model.fp32[tensor])
    return probeHandleRef(model.arena, bindings.memory[name], buffer.elements)

function fgProbePorts(model: FirGraph, names: string, layer: int): string
    var text = ""
    for name in names.splitWhitespace():
        if text.len > 0:
            text.add ","
        text.add name & "=" & fgProbeTensor(model, name, layer)
    return text

function fgProbeWeightAttrs(model: FirGraph, names: string, layer: int): string
    var text = ""
    for name in names.splitWhitespace():
        let buffer = model.graph.buffers[name]
        if buffer.kind == "weight":
            text = text & "," & name & ".tensor=" & probeQuote(fgTensorName(buffer, layer)) & "," & name & ".dtype=" & buffer.dtype & "," & name & ".shape=" & probeShape(buffer.dims)
    return text

function firFreeGraph(model: var FirGraph)
    let be = model.backend.kind.toByby()
    for weight in model.q4.mvalues:
        beResidentFreeQ4(weight)
    for weight in model.fp32.mvalues:
        sessionFree(be, weight)
    if model.rawPools.len > 0:
        for pool in model.rawPools.mitems:
            sessionFree(be, pool)
    else:
        for weight in model.rawWeights.mvalues:
            sessionFree(be, weight)
    for i in 0 ..< model.handles.len:
        sessionFree(be, model.handles[i])
    sessionFree(be, model.arena)
    sessionFree(be, model.linearInput)
    sessionFree(be, model.linearOutput)
    sessionFree(be, model.logitsReadback)
    sessionFree(be, model.phaseReadback)
    sessionFree(be, model.stage)
    sessionFree(be, model.scratchA)
    sessionFree(be, model.scratchB)
    sessionFree(be, model.scratchC)
    if model.checkpointMap.data != nil:
        try:
            firMappedFile.unmapReadOnlyFile(model.checkpointMap)
        except CatchableError:
            discard
    model.q4.clear()
    model.fp32.clear()
    model.rawWeights.clear()
    model.rawPools.setLen(0)
    model.rawBase.clear()
    model.handles.setLen(0)
    model.handleIndex.clear()
    model.failed = true

function fgPackedQ4Words(values: seq[float32], n: int, k: int, group: int): seq[float32]
    ## Packed asymmetric Q4 [out,in] as float words: the nibble bytes (4 per word), then the group
    ## scales, then the group zero points. Group size from the dtype (q4b/q4r: 32, q4b128: 128).
    let groups = (k+group-1) div group
    let packed = quantizeInt4AsymmetricGrouped(values, @[n, k], group)
    let words = (packed.data.len+3) div 4
    result = newSeq[float32](words+2*n*groups)
    for w in 0 ..< words:
        var bits = 0'u32
        for b in 0 ..< 4:
            let idx = w*4+b
            if idx < packed.data.len:
                bits = bits or (uint32(packed.data[idx]) shl uint32(8*b))
        result[w] = cast[float32](bits)
    for i in 0 ..< n*groups:
        result[words+i] = packed.scale[i]
        result[words+n*groups+i] = packed.zero_point[i]

function fgMemoryWeight(model: FirGraph, buffer: FirBuffer, values: seq[float32], words: var seq[float32]): bool
    ## The float words of a weight that micro kernels read from memory: a span of the arena, or a
    ## buffer of its own in a handle graph. False: the weight is resident in the backend instead
    ## (sessionMatmul / sessionMatmulQ4 operands).
    if buffer.dtype == "f32a":
        # Matrix kept in memory so micro kernels can read it.
        words = values
    elif buffer.dtype == "fp4km":
        # FP4-KM (group 32): the quantizer's byte block, then the decode table.
        let qt = quantizeFp4KM(values, @[buffer.dims[0], buffer.dims[1]])
        let count = (qt.data.len+3) div 4
        words = newSeq[float32](count+272)
        for w in 0 ..< count:
            var bits = 0'u32
            for b in 0 ..< 4:
                let idx = w*4+b
                if idx < qt.data.len:
                    bits = bits or (uint32(qt.data[idx]) shl uint32(8*b))
            words[w] = cast[float32](bits)
        let lut = fp4kmDecodeLut()
        for i in 0 ..< 16:
            words[count+i] = lut[i]
        let e4m3 = buildDecodeLUT(FP8_E4M3)
        for i in 0 ..< 256:
            words[count+16+i] = e4m3[i] * qt.scale[0]
    elif firQ4bGroup(buffer.dtype) > 0:
        words = fgPackedQ4Words(values, buffer.dims[0], buffer.dims[1], firQ4bGroup(buffer.dtype))
    elif buffer.dims.len == 1:
        words = values
    elif model.graph.layout == "script" and buffer.dtype == "f32" and buffer.dims.len != 2 and not model.useHandles:
        words = values
    else:
        return false
    return true

function fgUploadWeight(model: var FirGraph, name: string, buffer: FirBuffer, layer: int, values: seq[float32], memory: var seq[float32])
    let tensor = fgTensorName(buffer, layer)
    var expected = 1
    for d in buffer.dims:
        expected *= d
    if values.len != expected:
        raise newException(ValueError, "FIR graph invalid weight element count: " & tensor)
    let be = model.backend.kind.toByby()
    if firResidentQ4(model.graph, name):
        let n = buffer.dims[0]
        let k = buffer.dims[1]
        let group = firQ4bGroup(buffer.dtype)
        if model.nativeQ4 and fgNativeQ4Tensor(model.graph, name):
            let packed = quantizeInt4AsymmetricGrouped(values, @[n, k], group)
            model.q4[tensor] = beResidentUploadQ4(model.backend, packed.data, packed.scale, packed.zero_point, k, n, packed.groupSize, (k+group-1) div group)
            fgTuneNativeQ4(model, model.q4[tensor])
            probeName(model.q4[tensor], tensor, buffer.dtype, buffer.dims)
            return
        let key = fgResidentQ4HandleKey(name, layer)
        if model.handleIndex.hasKey(key):
            raise newException(ValueError, "FIR resident Q4 tensor was uploaded twice: " & tensor)
        model.handleIndex[key] = model.handles.len
        model.handles.add(sessionUpload(be, fgPackedQ4Words(values, n, k, group)))
        return
    var words: seq[float32]
    if fgMemoryWeight(model, buffer, values, words):
        if model.useHandles:
            # Handle graph: the weight is a buffer of its own in the layout the arena would hold, so
            # slot kernels bind it and arena-layout kernels stage it like any other port.
            if model.handleIndex.hasKey(name):
                raise newException(ValueError, "FIR handle graph weight was uploaded twice (per-layer weights need an arena graph): " & tensor)
            model.handleIndex[name] = model.handles.len
            model.handles.add(sessionUpload(be, words))
        else:
            let offset = fgLayerBindings(model, layer).memory[name]
            for i, value in words:
                memory[offset+i] = value
        return
    if buffer.dtype in ["q4", "q4t"]:
        # q4: checkpoint [in,out] -> resident [out,in] (transpose first).
        # q4t: checkpoint is already [out,in], quantize in place.
        let k = if buffer.dtype == "q4t": buffer.dims[1] else: buffer.dims[0]
        let n = if buffer.dtype == "q4t": buffer.dims[0] else: buffer.dims[1]
        var matrix = values
        if buffer.dtype == "q4":
            matrix = newSeq[float32](values.len)
            for j in 0 ..< n:
                for i in 0 ..< k:
                    matrix[j*k+i] = values[i*n+j]
        let packed = quantizeInt4AsymmetricGrouped(matrix, @[n, k], 32)
        model.q4[tensor] = beResidentUploadQ4(model.backend, packed.data, packed.scale, packed.zero_point, k, n, packed.groupSize, (k+31) div 32)
        probeName(model.q4[tensor], tensor, buffer.dtype, buffer.dims)
    else:
        # F32 linears stay [in,out] for sessionMatmul. Embeddings and tied
        # lm_head share a single [vocab,hidden] allocation, consumed with NT.
        model.fp32[tensor] = beResidentUploadFp32(model.backend, values)
        probeName(model.fp32[tensor], tensor, buffer.dtype, buffer.dims)

function fgUploadNativeQ4(model: var FirGraph, name: string, buffer: FirBuffer, layer: int, f: var File, tensor: ProbeTensor): bool
    let group = firQ4bGroup(buffer.dtype)
    if group <= 0 or tensor.kind != int(qkInt4Asymmetric) or tensor.groupSize != group or tensor.shape != buffer.dims:
        if model.nativeQ4 and getEnv("BYBY_FIR_Q4_MAP_LOG", "0") == "1":
            stderr.writeLine("[fir] resident Q4 fallback " & tensor.name & " dtype=" & buffer.dtype & " kind=" & $tensor.kind & "/" & $int(qkInt4Asymmetric) & " group=" & $tensor.groupSize & "/" & $group & " shapeMatch=" & $(tensor.shape == buffer.dims))
        return false
    let rows = buffer.dims[0]
    let cols = buffer.dims[1]
    let groups = (cols+group-1) div group
    let bytes = rows*((cols+1) div 2)
    if tensor.bytes != bytes or tensor.scales != rows*groups:
        raise newException(ValueError, "FIR graph packed resident Q4 layout mismatch: " & fgTensorName(buffer, layer))
    let words = (bytes+3) div 4
    if model.nativeQ4 and fgNativeQ4Tensor(model.graph, name):
        var scales = newSeq[float32](rows*groups)
        var zeros = newSeq[float32](rows*groups)
        f.setFilePos(tensor.scaleOffset)
        let scaleBytes = rows*groups*4
        if f.readBuffer(addr scales[0], scaleBytes) != scaleBytes or f.readBuffer(addr zeros[0], scaleBytes) != scaleBytes:
            raise newException(IOError, "FIR truncated native Q4 metadata: " & tensor.name)
        let key = fgTensorName(buffer, layer)
        var zeroCopy = false
        if model.checkpointMap.data != nil:
            let wq = cast[pointer](cast[uint](model.checkpointMap.data) + uint(tensor.offset))
            let uploaded = beResidentUploadQ4Mapped(model.backend, wq, bytes, scales, zeros, cols, rows, group, groups)
            model.q4[key] = uploaded.w
            zeroCopy = uploaded.zeroCopy
        else:
            var packed = newSeq[uint8](bytes)
            f.setFilePos(tensor.offset)
            if bytes > 0 and f.readBuffer(addr packed[0], bytes) != bytes:
                raise newException(IOError, "FIR truncated native tensor: " & tensor.name)
            model.q4[key] = beResidentUploadQ4(model.backend, packed, scales, zeros, cols, rows, group, groups)
        if getEnv("BYBY_FIR_Q4_MAP_LOG", "0") == "1":
            stderr.writeLine("[fir] resident Q4 " & tensor.name & (if zeroCopy: " mapped zero-copy" else: " uploaded copy"))
        fgTuneNativeQ4(model, model.q4[key])
        probeName(model.q4[key], tensor.name, buffer.dtype, buffer.dims)
        return true
    var encoded = newSeq[float32](words+2*rows*groups)
    f.setFilePos(tensor.offset)
    # The native checkpoint and supported GPU hosts are little-endian, so the
    # packed byte stream can be read straight into its float-word slot.
    if bytes > 0 and f.readBuffer(addr encoded[0], bytes) != bytes:
        raise newException(IOError, "FIR truncated native tensor: " & tensor.name)
    f.setFilePos(tensor.scaleOffset)
    let scaleBytes = rows*groups*4
    if f.readBuffer(addr encoded[words], scaleBytes) != scaleBytes:
        raise newException(IOError, "FIR truncated native scales: " & tensor.name)
    if f.readBuffer(addr encoded[words+rows*groups], scaleBytes) != scaleBytes:
        raise newException(IOError, "FIR truncated native zero points: " & tensor.name)
    let key = fgResidentQ4HandleKey(name, layer)
    if model.handleIndex.hasKey(key):
        raise newException(ValueError, "FIR resident Q4 tensor was uploaded twice: " & tensor.name)
    model.handleIndex[key] = model.handles.len
    model.handles.add(sessionUpload(model.backend.kind.toByby(), encoded))
    return true

function fgSlotGlsl(kernel: FirKernel, name: string): string
    # Keep descriptor offsets aligned at zero. Apply byte/float view bases to
    # generated indexing instead; the recorded program words stay untouched.
    let source = lowerBytecodeToGlsl(kernel.program, name)
    let start = source.find("void atomicAddFloat")
    var body = source[start .. ^1]
    let arrays = @["memF32", "memU8", "lut", "inF32", "memU32"]
    for i in 0 .. 4:
        let offset = if kernel.slotOffsets[i] >= 0: kernel.slotOffsets[i] elif i == 4: max(0, kernel.slotOffsets[0]) else: 0
        body = body.replace(arrays[i] & "[", arrays[i] & "[" & $offset & "u+")
    source[0 ..< start] & body

const FgPoolFloats = 64 * 1024 * 1024    # 256 MiB per packed pool; a larger tensor or group gets a pool of its own
const FgPoolAlign = 64                    # floats; keeps every bind offset a multiple of 256 bytes
const FgPoolMax = 256 * 1024 * 1024       # floats; one Metal buffer must stay below 1 GiB

function fgFindRoot(parent: Table[string, string], name: string): string
    var cur = name
    while parent[cur] != cur:
        cur = parent[cur]
    return cur

function fgPlanPools(model: var FirGraph)
    ## Packs the raw weights into a few large buffers. Weights that one kernel reaches through
    ## `rebase` must share a pool, so they are packed first as one group. Pure function of the
    ## graph: the rebase deltas baked into kernel words are known before any weight is read.
    var names: seq[string]
    for name, buffer in model.graph.buffers:
        if firResidentRaw(model.graph, name):
            names.add(name)
    names.sort()
    var parent = initTable[string, string]()
    for name in names:
        parent[name] = name
    for node in model.graph.nodes:
        if node.kind != "micro" or not model.graph.kernels.hasKey(node.op):
            continue
        var rebased = false
        for line in model.graph.kernels[node.op].body:
            if line.mnemonic == "rebase":
                rebased = true
        if not rebased:
            continue
        var first = ""
        for port in node.inputs.splitWhitespace():
            if not model.graph.buffers.hasKey(port):
                continue
            let base = if model.graph.buffers[port].viewOf.len > 0: model.graph.buffers[port].viewOf else: port
            if not parent.hasKey(base):
                continue
            if first.len == 0:
                first = base
            else:
                parent[fgFindRoot(parent, base)] = fgFindRoot(parent, first)
    var groups = initTable[string, seq[string]]()
    var order: seq[string]
    for name in names:
        let root = fgFindRoot(parent, name)
        if not groups.hasKey(root):
            groups[root] = newSeq[string]()
            order.add(root)
        groups[root].add(name)
    var current: seq[string]
    var used = 0
    for root in order:
        var size = 0
        for name in groups[root]:
            size += ((model.graph.buffers[name].elements + FgPoolAlign - 1) div FgPoolAlign) * FgPoolAlign
        if size > FgPoolMax:
            raise newException(ValueError, "FIR rebase group needs " & $size & " weight floats in one pool (limit " & $FgPoolMax & "): " & groups[root][0])
        if current.len > 0 and used + size > FgPoolFloats:
            model.rawPlan.add(current)
            current = newSeq[string]()
            used = 0
        for name in groups[root]:
            model.rawBase[name] = used
            current.add(name)
            used += ((model.graph.buffers[name].elements + FgPoolAlign - 1) div FgPoolAlign) * FgPoolAlign
    if current.len > 0:
        model.rawPlan.add(current)

function fgPlanRebase(model: var FirGraph)
    ## Where every buffer lives: the allocation (arena root or weight pool) and the float offset in it.
    for name, buffer in model.graph.buffers:
        let base = if buffer.viewOf.len > 0: buffer.viewOf else: name
        if firResidentRaw(model.graph, base) and model.rawBase.hasKey(base):
            var pool = 0
            for index, members in model.rawPlan:
                if base in members:
                    pool = index
            model.graph.rebaseUnit[name] = "pool" & $pool
            model.graph.rebaseOff[name] = model.rawBase[base] + buffer.viewOffset
        else:
            model.graph.rebaseUnit[name] = base
            model.graph.rebaseOff[name] = buffer.viewOffset

function fgQ4CoopKernel(def: FirKernelDef): bool
    for line in def.body:
        if line.mnemonic == "words" and line.args.len > 0:
            try:
                return (uint32(parseHexInt(line.args[0])) and 0xFF'u32) == OP_Q4_COOP_GEMM
            except ValueError:
                return false
    false

function fgQ4CoopTile(model: FirGraph, rows, n: int): int
    ## Row tile (rows per workgroup) of a Q4 Tensor Core micro-kernel dispatch over `rows` rows on
    ## this device: the tallest tile whose grid still gives each SM/CU coopPerUnit workgroups.
    if model.coopForcedRows > 0:
        return model.coopForcedRows
    q4CoopRowTile(rows, n, model.computeUnits, model.coopPerUnit)

function fgPrepare(graph: FirProgram, backend: Backend, registry: FirRegistry): FirGraph
    if graph.runtime != "graph":
        raise newException(ValueError, "FIR graph executor requires 'runtime graph' in the model file")
    for name in ["layers", "positions", "vocab"]:
        if not graph.symbols.hasKey(name):
            raise newException(ValueError, "FIR graph needs symbol '" & name & "' (define it with sym)")
    discard firRoleBuffer(graph, "token")
    discard firRoleBuffer(graph, "position")
    discard firRoleBuffer(graph, "logits")
    result.graph = graph
    result.registry = registry
    result.bindings = firGraphBindings(graph, true)
    result.useHandles = firDataGraph(graph)
    let q4Backend = getEnv("BYBY_FIR_Q4_BACKEND", "micro").toLowerAscii()
    if q4Backend notin ["micro", "native"]:
        raise newException(ValueError, "BYBY_FIR_Q4_BACKEND must be micro or native")
    result.nativeQ4 = q4Backend == "native"
    if result.nativeQ4:
        for node in graph.nodes:
            if node.kind == "micro" and graph.kernels.hasKey(node.op) and fgQ4CoopKernel(graph.kernels[node.op]):
                raise newException(ValueError, "FIR Q4 Tensor Core micro-kernel requires BYBY_FIR_Q4_BACKEND=micro; native Q4 would bypass the custom micro-kernel")
    result.backend = backend
    firValidate(graph, registry, result.bindings)
    if backend.kind.toByby() != gbCpu:
        fgPlanPools(result)
    fgPlanRebase(result)
    let be = backend.kind.toByby()
    if not ensureGpuInit(be):
        raise newException(ValueError, "FIR graph backend initialization failed")
    result.computeUnits = gpuComputeUnits(be)
    result.coopPerUnit = parseInt(getEnv("BYBY_FIR_Q4_COOP_WG_PER_UNIT", "2"))
    if result.coopPerUnit < 1:
        raise newException(ValueError, "BYBY_FIR_Q4_COOP_WG_PER_UNIT must be at least 1")
    let forcedRows = getEnv("BYBY_FIR_Q4_COOP_ROWS", "")
    if forcedRows.len > 0:
        result.coopForcedRows = parseInt(forcedRows)
        if result.coopForcedRows notin Q4CoopRowTiles:
            raise newException(ValueError, "BYBY_FIR_Q4_COOP_ROWS must be 16, 32 or 64")
    let coopVerbose = getEnv("BYBY_FIR_Q4_COOP_VERBOSE", "0") != "0"
    var coopLogged = initTable[string, bool]()
    # Q4 micro-kernels follow the device: subgroup sums and one Tensor Core fragment per
    # subgroup need compute subgroups that are exactly 32 wide (NVIDIA guarantees it).
    let fixedWidth = gpuFixedSubgroupWidth(be)
    result.coopFragments = if fixedWidth == 32: 1 else: 2
    result.gemvSubgroupSum = fixedWidth == 32
    result.gemvRows = parseInt(getEnv("BYBY_FIR_Q4_GEMV_ROWS", $Q4GemvDefaultRows))
    if result.gemvRows notin Q4GemvRowChoices:
        raise newException(ValueError, "BYBY_FIR_Q4_GEMV_ROWS must be 1, 2 or 4")
    let gemvReduce = getEnv("BYBY_FIR_Q4_GEMV_REDUCE", "auto").toLowerAscii()
    if gemvReduce == "shared":
        result.gemvSubgroupSum = false
    elif gemvReduce == "subgroup":
        if fixedWidth != 32:
            raise newException(ValueError, "BYBY_FIR_Q4_GEMV_REDUCE=subgroup needs 32-wide compute subgroups; this Vulkan device does not guarantee them")
        result.gemvSubgroupSum = true
    elif gemvReduce != "auto":
        raise newException(ValueError, "BYBY_FIR_Q4_GEMV_REDUCE must be auto, subgroup or shared")
    var cfg = defaultJitConfig()
    cfg.enableMetalJit = be == gbMetal
    cfg.hotThreshold = 1
    cfg.maxCacheEntries = 1024
    var jit = initJitCache(cfg)
    var jobs: seq[tuple[name, source: string]]
    var cpuUnits: seq[CpuJitUnit]
    var cpuSeen = initTable[string, bool]()
    var metaFloats = 0
    for node in graph.nodes:
        if node.kind == "micro":
            if result.nativeQ4 and fgNativeQ4Weight(graph, node).len > 0:
                continue
            for layer in 0 ..< (if node.perLayer: graph.symbols["layers"] else: 1):
                var nodeBindings = fgLayerBindings(result, layer)
                var staged: seq[FgStagePort]
                let isSlots = graph.kernels.hasKey(node.op) and graph.kernels[node.op].layout == "slots"
                if result.useHandles and not isSlots:
                    # Arena-layout kernel over resident per-buffer handles: lay the node's ports out
                    # contiguously in a staging arena (copied in before and out after the dispatch).
                    var cursor = 0
                    let inputNames = node.inputs.splitWhitespace()
                    let outputNames = node.outputs.splitWhitespace()
                    for name in inputNames & outputNames:
                        var seen = false
                        for port in staged:
                            if port.name == name:
                                seen = true
                        if seen or not graph.buffers.hasKey(name):
                            continue
                        cursor = ((cursor+63) div 64)*64
                        let elements = graph.buffers[name].elements
                        staged.add(FgStagePort(name: name, offset: cursor, elements: elements, reads: name in inputNames, writes: name in outputNames))
                        nodeBindings.memory[name] = cursor
                        cursor += elements
                    result.stageFloats = max(result.stageFloats, cursor)
                # Metal, arena layout: position-independent programs, so every node of a kernel shares one
                # compiled pipeline (a graph has a thousand nodes and a few dozen kernels). BYBY_FIR_RELOC=0
                # keeps one program per node.
                let relocatable = be == gbMetal and not result.useHandles and not isSlots and getEnv("BYBY_FIR_RELOC", "1") != "0"
                let kernel = firMicroKernel(node, result.graph, registry, nodeBindings, relocatable)
                if kernel.program.words.len > 0 and
                    (kernel.program.words[0] and 0xFF'u32) == OP_Q4_COOP_GEMM:
                    if be == gbVulkan:
                        if not sessionCooperativeGemmEnabled(be):
                            raise newException(ValueError, "FIR Q4 Tensor Core micro-kernel requires Vulkan KHR_cooperative_matrix support")
                    elif be != gbCpu:
                        raise newException(ValueError, "FIR Q4 Tensor Core micro-kernel is Vulkan-only")
                if isQ4GemvProgram(kernel.program) and be notin [gbVulkan, gbCpu]:
                    raise newException(ValueError, "FIR Q4 subgroup GEMV micro-kernel is Vulkan-only; re-lift with FIRLIFT_Q4_GEMV=simd or word_parallel")
                var prepared = FgResidentProgram(kernel: kernel, stage: staged, metaOffset: -1)
                if kernel.relocBuffers.len > 0:
                    prepared.metaOffset = result.bindings.memoryFloats + metaFloats
                    for i, name in kernel.relocBuffers:
                        let address = nodeBindings.memory[name]
                        result.metaWrites.add((prepared.metaOffset + 2*i, float32(address div 4096)))
                        result.metaWrites.add((prepared.metaOffset + 2*i + 1, float32(address mod 4096)))
                    metaFloats += ((2*kernel.relocBuffers.len + 3) div 4)*4
                if be == gbMetal:
                    prepared.name = dispatchProgramNoSession(jit, kernel.program, node.op)
                    if prepared.name == "micro_vm_kernel":
                        raise newException(ValueError, "FIR graph Metal JIT compilation failed: " & node.op)
                elif be == gbVulkan:
                    prepared.name = kernelNameFor(jit, kernel.program, node.op)
                    if isQ4CoopProgram(kernel.program):
                        # Build every row tile a dispatch of 1..M rows can pick on this device;
                        # fgEncodeMicroBody chooses one and sizes the grid per dispatch.
                        let shape = q4CoopShape(kernel.program)
                        for rows in 1 .. shape.M:
                            let tile = fgQ4CoopTile(result, rows, shape.N)
                            if tile notin prepared.coopTiles:
                                let tileName = prepared.name & "_r" & $tile
                                prepared.coopTiles.add(tile)
                                prepared.coopNames.add(tileName)
                                prepared.coopSources.add(lowerQ4CoopGlsl(kernel.program, tileName, tile, result.coopFragments))
                                jobs.add((tileName, prepared.coopSources[^1]))
                        prepared.source = prepared.coopSources[prepared.coopTiles.find(fgQ4CoopTile(result, shape.M, shape.N))]
                        if coopVerbose and not coopLogged.hasKey(node.op):
                            coopLogged[node.op] = true
                            let fullTile = fgQ4CoopTile(result, shape.M, shape.N)
                            stderr.writeLine("[fir] Q4 Tensor Core " & node.op & " K=" & $shape.K & " N=" & $shape.N & " M=" & $shape.M & ": row tile " & $fullTile & " (tiles built " & $prepared.coopTiles & ", " & $result.computeUnits & " SM/CU, " & $result.coopFragments & " fragment(s) per subgroup)")
                    elif isQ4GemvProgram(kernel.program):
                        # Rows per subgroup and the reduction follow the device; the grid follows from them.
                        prepared.gemvRows = result.gemvRows
                        prepared.name = prepared.name & "_r" & $result.gemvRows & (if result.gemvSubgroupSum: "_sg" else: "_shm")
                        prepared.source = lowerQ4GemvGlsl(kernel.program, prepared.name, result.gemvRows, not result.gemvSubgroupSum, kernel.tgSize)
                        jobs.add((prepared.name, prepared.source))
                        if coopVerbose and not coopLogged.hasKey(node.op):
                            coopLogged[node.op] = true
                            let shape = q4GemvShape(kernel.program)
                            stderr.writeLine("[fir] Q4 GEMV " & node.op & " K=" & $shape.K & " N=" & $shape.N & ": " & $result.gemvRows & " row(s) per subgroup, " & (if result.gemvSubgroupSum: "subgroupAdd" else: "shared-memory sum"))
                    else:
                        prepared.source = glslSourceFor(jit, kernel.program, node.op)
                        # Subgroup kernels (FIRLIFT_Q4_GEMV=simd) size their grid for 32-lane subgroups.
                        if prepared.source.contains("GL_KHR_shader_subgroup_arithmetic") and gpuFixedSubgroupWidth(be) != 32:
                            raise newException(ValueError, "FIR kernel " & node.op & " reduces across 32-lane subgroups, which this Vulkan device does not guarantee; re-lift with FIRLIFT_Q4_GEMV=word_parallel and FIRLIFT_SIMD=0")
                        jobs.add((prepared.name, prepared.source))
                elif be == gbCpu and cpuJitEnabled() and not kernel.slotLayout and staged.len == 0:
                    # Compile the micro-kernel to native code; unsupported programs keep the interpreter.
                    let cpuName = cpuJitFunctionName(kernel.program)
                    if not cpuSeen.hasKey(cpuName):
                        cpuSeen[cpuName] = false
                        let cpuSource = cpuJitSource(kernel.program, cpuName)
                        if cpuSource.len > 0:
                            cpuUnits.add((name: cpuName, source: cpuSource))
                            cpuSeen[cpuName] = true
                    if cpuSeen[cpuName]:
                        prepared.name = cpuName
                result.programs[fgNodeKey(node, layer)] = prepared
        elif node.kind notin ["ext", "session"]:
            raise newException(ValueError, "FIR graph executor supports micro, ext and session nodes: " & node.name)
    # The address tables sit after everything else in the arena.
    result.bindings.memoryFloats += metaFloats
    sessionJitPrewarm(be, jobs)
    if cpuUnits.len > 0:
        let compiled = cpuJitBuild(cpuUnits)
        var programKeys: seq[string]
        for key, item in result.programs:
            programKeys.add key
        for key in programKeys:
            var item = result.programs[key]
            if item.name.len > 0 and compiled.hasKey(item.name):
                item.cpuFn = compiled[item.name]
                result.programs[key] = item

function fgPortBase(model: FirGraph, name: string): string
    result = name
    if model.graph.buffers.hasKey(name) and model.graph.buffers[name].viewOf.len > 0:
        result = model.graph.buffers[name].viewOf
    return result

function fgPortOffset(model: FirGraph, name: string, layer: int = 0): int
    result = 0
    if model.graph.buffers.hasKey(name):
        result = model.graph.buffers[name].viewOffset
    let base = fgPortBase(model, name)
    if firResidentQ4(model.graph, base):
        return 0
    if not model.useHandles and model.bindings.memory.hasKey(name):
        # Arena graph: the float offset of the buffer (or view) inside the arena.
        result = model.bindings.memory[name]
        if model.graph.buffers[name].perLayer or model.graph.buffers[name].tensorName.contains("{i}"):
            result += layer*model.graph.buffers[name].elements
        return result
    if model.graph.buffers.hasKey(name) and
        (model.graph.buffers[name].perLayer or model.graph.buffers[name].tensorName.contains("{i}")):
        result += layer*model.graph.buffers[name].elements
    if model.rawBase.hasKey(base):
        result += model.rawBase[base]
    return result

function fgPortHandleIndex(model: FirGraph, name: string, layer: int = 0): int
    let base = fgPortBase(model, name)
    if firResidentQ4(model.graph, base):
        return model.handleIndex.getOrDefault(fgResidentQ4HandleKey(base, layer), -1)
    if model.handleIndex.hasKey(base):
        return model.handleIndex[base]
    return -1

function fgPortHandle(model: FirGraph, name: string, layer: int = 0): SessionHandle
    let base = fgPortBase(model, name)
    if model.rawWeights.hasKey(base):
        return model.rawWeights[base]
    if firResidentQ4(model.graph, base):
        let key = fgResidentQ4HandleKey(base, layer)
        if model.handleIndex.hasKey(key):
            return model.handles[model.handleIndex[key]]
        raise newException(ValueError, "FIR resident Q4 tensor handle is missing: " & name)
    if model.handleIndex.hasKey(base):
        return model.handles[model.handleIndex[base]]
    return model.arena

function fgInitValues(model: FirGraph, buffer: FirBuffer): seq[float32]
    result = newSeq[float32](buffer.elements)
    if buffer.initialWords.len > 0:
        for i, word in buffer.initialWords:
            result[i] = cast[float32](word)
    elif buffer.initFile.len > 0:
        let path = firInitPath(model.graph, buffer, model.checkpoint)
        var f = open(path, fmRead)
        try:
            f.setFilePos(buffer.initOffset)
            if f.readBuffer(addr result[0], buffer.initBytes) != buffer.initBytes:
                raise newException(IOError, "FIR truncated initializer: " & buffer.name)
        finally:
            f.close()

function fgWriteMeta(model: FirGraph, memory: var seq[float32])
    ## Fills the address tables of the position-independent kernels (before the arena is uploaded).
    for item in model.metaWrites:
        memory[item.offset] = item.value

function fgAllocate(model: var FirGraph, memory: seq[float32])
    let be = model.backend.kind.toByby()
    if model.useHandles:
        for name, buffer in model.graph.buffers:
            if buffer.viewOf.len > 0:
                continue
            if firResidentRaw(model.graph, name):
                continue
            if firResidentQ4(model.graph, name):
                continue
            if model.handleIndex.hasKey(name):
                continue
            if buffer.kind == "weight" and buffer.dtype != "raw":
                # Uploaded by fgUploadWeight: a buffer of its own above, or resident in the backend.
                continue
            let values = fgInitValues(model, buffer)
            model.handleIndex[name] = model.handles.len
            model.handles.add(sessionUpload(be, values))
            if buffer.initFile.len > 0 or buffer.initialWords.len > 0:
                model.initialState.add((0, name))
    else:
        model.arena = sessionUpload(be, memory)
        if be == gbMetal and model.arena.metalHandle.isNil:
            # Activations, state (the KV caches grow with the context) and small weights share
            # this one buffer; the device limits how large a single buffer may be.
            raise newException(ValueError, "FIR graph arena of " & $(memory.len div 262144) & " MiB does not fit one device buffer; lift and run with a smaller context")
        for name, buffer in model.graph.buffers:
            if buffer.kind != "weight" and (buffer.initFile.len > 0 or buffer.initialWords.len > 0):
                model.initialState.add((model.bindings.memory[name], name))
    if not model.useHandles and unlikely(firProbeOn):
        for name, buffer in model.graph.buffers:
            if firResidentRaw(model.graph, name) or firResidentQ4(model.graph, name):
                continue
            if model.bindings.memory.hasKey(name):
                for layer in 0 ..< (if buffer.tensorName.contains("{i}"): model.graph.symbols["layers"] else: 1):
                    let offset = fgLayerBindings(model, layer).memory[name]*4
                    if buffer.kind == "weight":
                        probeName(model.arena, fgTensorName(buffer, layer), buffer.dtype, buffer.dims, offset, buffer.elements*4)
                    elif buffer.role.len > 0:
                        probeRole(model.arena, buffer.role, offset, buffer.elements*4)
    var largest = model.graph.symbols["vocab"]
    for name, buffer in model.graph.buffers:
        if buffer.kind != "weight" and not buffer.perLayer:
            largest = max(largest, buffer.elements)
    model.linearInput = sessionAllocScratch(be, largest)
    model.linearOutput = sessionAllocScratch(be, largest)
    model.logitsReadback = sessionAllocScratch(be, model.graph.symbols["vocab"])
    var phaseFloats = 1
    for name, buffer in model.graph.phaseLast:
        if not model.graph.buffers.hasKey(buffer) or model.graph.buffers[buffer].elements != model.graph.symbols["vocab"]:
            raise newException(ValueError, "FIR phase " & name & ": last= buffer must hold vocab floats")
        phaseFloats = max(phaseFloats, model.graph.buffers[buffer].elements)
    for name, buffer in model.graph.phaseLogits:
        if not model.graph.buffers.hasKey(buffer) or model.graph.buffers[buffer].elements != model.graph.phases[name]*model.graph.symbols["vocab"]:
            raise newException(ValueError, "FIR phase " & name & ": logits buffer must hold rows*vocab floats")
        phaseFloats = max(phaseFloats, model.graph.buffers[buffer].elements)
    model.phaseReadback = sessionAllocScratch(be, phaseFloats)
    if model.stageFloats > 0:
        model.stage = sessionAllocScratch(be, model.stageFloats)
    var scratch = 1
    for node in model.graph.nodes:
        if node.kind == "session":
            for port in (node.inputs & " " & node.outputs).splitWhitespace():
                if model.graph.buffers.hasKey(port):
                    scratch = max(scratch, model.graph.buffers[port].elements)
    largest = max(largest, scratch)
    model.scratchA = sessionAllocScratch(be, scratch)
    model.scratchB = sessionAllocScratch(be, scratch)
    model.scratchC = sessionAllocScratch(be, scratch)
    probeRole(model.logitsReadback, "logits")

function fgLoadRawWeights(model: var FirGraph, checkpoint: string)
    let be = model.backend.kind.toByby()
    if be == gbCpu:
        for name, buffer in model.graph.buffers:
            if firResidentRaw(model.graph, name):
                model.rawWeights[name] = sessionUploadPrivate(be, firReadRawInitializer(model.graph, checkpoint, buffer))
        return
    for members in model.rawPlan:
        # One pool of host memory at a time; no checkpoint-sized arena.
        var pending = newSeq[float32]()
        for name in members:
            let values = firReadRawInitializer(model.graph, checkpoint, model.graph.buffers[name])
            if pending.len != model.rawBase[name]:
                raise newException(ValueError, "FIR weight pool plan out of sync: " & name)
            for value in values:
                pending.add(value)
            while pending.len mod FgPoolAlign != 0:
                pending.add(0.0)
        let pool = sessionUploadPrivate(be, pending)
        model.rawPools.add(pool)
        for name in members:
            model.rawWeights[name] = pool

function firNewGraph(graph: FirProgram, weights: Table[string, seq[float32]], backend: Backend, registry: FirRegistry): FirGraph
    result = fgPrepare(graph, backend, registry)
    try:
        var memory = if result.useHandles: newSeq[float32]() else: newSeq[float32](result.bindings.memoryFloats)
        for name, buffer in graph.buffers:
            if buffer.kind != "weight" or buffer.dtype == "raw":
                continue
            for layer in 0 ..< (if buffer.tensorName.contains("{i}"): graph.symbols["layers"] else: 1):
                let tensor = fgTensorName(buffer, layer)
                if not weights.hasKey(tensor):
                    raise newException(ValueError, "FIR graph missing weight: " & tensor)
                fgUploadWeight(result, name, buffer, layer, weights[tensor], memory)
        fgLoadRawWeights(result, "")
        if not result.useHandles:
            firInitializeData(graph, "", memory, result.bindings)
        fgWriteMeta(result, memory)
        fgAllocate(result, memory)
    except:
        firFreeGraph(result)
        raise

function fgLoadNative(graph: FirProgram, path: string, backend: Backend): FirGraph
    ## Weights from a native .nimq checkpoint. A packed asymmetric Q4 tensor whose group size and
    ## shape match a q4b weight is copied as stored (nibble bytes, then scales, then zero points):
    ## no dequantize/requantize pass at load, and the graph computes with the very values the
    ## native runtime uses. Every other tensor is dequantized to f32 and takes the usual path.
    firCheckDataWeights(graph, path)
    let index = probeTensorIndex(path)
    result = fgPrepare(graph, backend, firDefaultRegistry())
    result.checkpoint = path
    if result.nativeQ4:
        try:
            result.checkpointMap = firMappedFile.openReadOnlyMapping(path)
        except CatchableError:
            discard
    try:
        var memory = if result.useHandles: newSeq[float32]() else: newSeq[float32](result.bindings.memoryFloats)
        var f = open(path, fmRead)
        try:
            for name, buffer in graph.buffers:
                if buffer.kind != "weight":
                    continue
                for layer in 0 ..< (if buffer.tensorName.contains("{i}"): graph.symbols["layers"] else: 1):
                    let tensorName = fgTensorName(buffer, layer)
                    var found = -1
                    for i, tensor in index:
                        if tensor.name == tensorName:
                            found = i
                    if found < 0:
                        for prefix in graph.prefixes:
                            for i, tensor in index:
                                if tensor.name == prefix & tensorName:
                                    found = i
                    if found < 0:
                        raise newException(ValueError, "FIR graph checkpoint lacks tensor: " & tensorName)
                    let tensor = index[found]
                    if firResidentQ4(graph, name):
                        if not fgUploadNativeQ4(result, name, buffer, layer, f, tensor):
                            fgUploadWeight(result, name, buffer, layer, firReadNativeF32(path, tensor), memory)
                        continue
                    let group = firQ4bGroup(buffer.dtype)
                    if group > 0 and tensor.kind == int(qkInt4Asymmetric) and tensor.groupSize == group and tensor.shape == buffer.dims:
                        let rows = buffer.dims[0]
                        let groups = (buffer.dims[1]+group-1) div group
                        let bytes = rows*((buffer.dims[1]+1) div 2)
                        if tensor.bytes != bytes or tensor.scales != rows*groups:
                            raise newException(ValueError, "FIR graph packed Q4 layout mismatch: " & tensorName)
                        let offset = fgLayerBindings(result, layer).memory[name]
                        let words = (bytes+3) div 4
                        f.setFilePos(tensor.offset)
                        if f.readBuffer(addr memory[offset], bytes) != bytes:
                            raise newException(IOError, "FIR truncated native tensor: " & tensorName)
                        # The file keeps the scales, then the zero points, right after the tensor header.
                        f.setFilePos(tensor.scaleOffset)
                        if f.readBuffer(addr memory[offset+words], rows*groups*8) != rows*groups*8:
                            raise newException(IOError, "FIR truncated native scales: " & tensorName)
                    else:
                        fgUploadWeight(result, name, buffer, layer, firReadNativeF32(path, tensor), memory)
        finally:
            f.close()
        fgLoadRawWeights(result, path)
        if not result.useHandles:
            firInitializeData(graph, path, memory, result.bindings)
        fgWriteMeta(result, memory)
        fgAllocate(result, memory)
    except:
        firFreeGraph(result)
        raise

function firLoadGraph(graph: FirProgram, path: string, backend: Backend): FirGraph
    firCheckScriptContract(graph)
    if firDataGraph(graph):
        firCheckDataWeights(graph, path)
        result = fgPrepare(graph, backend, firDefaultRegistry())
        result.checkpoint = path
        try:
            var memory = if result.useHandles: newSeq[float32]() else: newSeq[float32](result.bindings.memoryFloats)
            let native = path.endsWith(".nimq")
            let index = if native: probeTensorIndex(path) else: newSeq[ProbeTensor]()
            var header: FmSafeHeader
            if not native:
                header = fmReadSafeHeader(path)
            for name, buffer in graph.buffers:
                if buffer.kind != "weight" or buffer.dtype == "raw":
                    continue
                var values: seq[float32]
                if native:
                    var packed = false
                    for tensor in index:
                        if tensor.name == buffer.tensorName:
                            if firResidentQ4(graph, name):
                                # Copy the packed Q4 bytes as stored: the graph then computes with
                                # the very values the native runtime uses.
                                var f = open(path, fmRead)
                                try:
                                    packed = fgUploadNativeQ4(result, name, buffer, 0, f, tensor)
                                finally:
                                    f.close()
                            if not packed:
                                values = firReadNativeF32(path, tensor)
                    if packed:
                        continue
                else:
                    let source = fmResolveTensor(header, graph.prefixes, buffer.tensorName)
                    values = fmLoadSafeF32(path, header, source, buffer.dims, true)
                fgUploadWeight(result, name, buffer, 0, values, memory)
            fgLoadRawWeights(result, path)
            if not result.useHandles:
                firInitializeData(graph, path, memory, result.bindings)
            fgWriteMeta(result, memory)
            fgAllocate(result, memory)
        except:
            firFreeGraph(result)
            raise
        return result
    if path.endsWith(".nimq"):
        return fgLoadNative(graph, path, backend)
    let header = fmReadSafeHeader(path)
    if graph.layout == "script":
        # Check every selected layer before backend preparation or weight upload.
        for name, buffer in graph.buffers:
            if buffer.kind != "weight":
                continue
            for layer in 0 ..< (if buffer.tensorName.contains("{i}"): graph.symbols["layers"] else: 1):
                let tensor = fgTensorName(buffer, layer)
                let source = fmResolveTensor(header, graph.prefixes, tensor)
                if source.len == 0:
                    raise newException(ValueError, "FIR graph checkpoint lacks tensor: " & tensor)
                discard fmValidateScriptTensor(header, source, buffer.dims)
    result = fgPrepare(graph, backend, firDefaultRegistry())
    try:
        var memory = newSeq[float32](result.bindings.memoryFloats)
        for name, buffer in graph.buffers:
            if buffer.kind != "weight":
                continue
            for layer in 0 ..< (if buffer.tensorName.contains("{i}"): graph.symbols["layers"] else: 1):
                let tensor = fgTensorName(buffer, layer)
                # Load, transpose/quantize and upload each tensor once; release
                # its host F32 payload before loading the next matrix.
                let source = fmResolveTensor(header, graph.prefixes, tensor)
                if source.len == 0:
                    raise newException(ValueError, "FIR graph checkpoint lacks tensor: " & tensor)
                let values = fmLoadSafeF32(path, header, source, buffer.dims, graph.layout == "script")
                fgUploadWeight(result, name, buffer, layer, values, memory)
        fgWriteMeta(result, memory)
        fgAllocate(result, memory)
    except:
        firFreeGraph(result)
        raise

function fgDispatchArena(model: var FirGraph, prepared: FgResidentProgram, staged: bool, threads: int): bool
    ## Runs an arena-layout kernel over the arena, or over the staging arena of a handle graph.
    let be = model.backend.kind.toByby()
    let k = prepared.kernel
    if be == gbCpu:
        # Production framework VM, in place (a copy of the handle would copy the CPU buffer and
        # the VM would write the copy); vm_interp is used only in tests.
        if staged:
            return cpu_backend.vmRun(k.program.words, model.stage.cpuData, newSeq[float32](), threads, max(4, k.tgBytes div 4), k.tgSize)
        return cpu_backend.vmRun(k.program.words, model.arena.cpuData, newSeq[float32](), threads, max(4, k.tgBytes div 4), k.tgSize)
    var arena = if staged: model.stage else: model.arena
    if be == gbVulkan:
        result = sessionJitMicroVmEnc(be, prepared.name, prepared.source, arena, threads, k.tgSize, max(4, k.tgBytes div 4))
        if result and unlikely(firProbeOn):
            probeGpuDispatch(probeProgram(k.program.words), prepared.name, threads, k.tgSize, k.tgBytes)
        return
    # Compiled MSL ignores the bytecode binding. All arithmetic is already in
    # the prepared pipeline, and all addresses refer to the resident arena.
    if prepared.metaOffset >= 0 and not sessionPipeline(prepared.name):
        return false
    if prepared.metaOffset >= 0 and not sessionBindBuffer(4, arena.metalHandle, prepared.metaOffset*4):
        return false
    result = sessionPipeline(prepared.name) and sessionBindBuffer(0, arena.metalHandle) and sessionBindBuffer(1, arena.metalHandle) and sessionBindBuffer(2, arena.metalHandle) and sessionBindBuffer(3, arena.metalHandle) and sessionSetThreadgroupBytes(0, max(16, k.tgBytes)) and sessionDispatch(threads, k.tgSize)
    if result and unlikely(firProbeOn):
        probeGpuDispatch(probeProgram(k.program.words), prepared.name, threads, k.tgSize, k.tgBytes)

function fgEncodeMicroBody(model: var FirGraph, prepared: FgResidentProgram, node: FirNode, layer: int): bool
    let be = model.backend.kind.toByby()
    let k = prepared.kernel
    inc model.dispatched
    # A partial phase run launches only the threads of its first rows (kernels that declare rows=B:T).
    var threads = k.threads
    if model.activeRows > 0 and model.graph.kernels.hasKey(node.op):
        let def = model.graph.kernels[node.op]
        if def.rowBlock > 0:
            threads = min(threads, ((model.activeRows + def.rowBlock - 1) div def.rowBlock) * def.rowThreads)
    if k.slotLayout:
        if be == gbCpu:
            var views: array[5, CpuVmView]
            var held: array[5, SessionHandle]
            for i in 0 .. 4:
                if k.slotBuffers[i].len == 0:
                    continue
                let name = k.slotBuffers[i]
                let offset = fgPortOffset(model, name, layer)
                let index = fgPortHandleIndex(model, name, layer)
                if index >= 0:
                    views[i] = CpuVmView(base: cast[ptr float32](addr model.handles[index].cpuData[0]), offset: offset, elements: k.slotSizes[i], allocationElements: model.handles[index].cpuData.len)
                else:
                    let base = fgPortBase(model, name)
                    if model.rawWeights.hasKey(base):
                        held[i] = model.rawWeights[base]
                        views[i] = CpuVmView(base: cast[ptr float32](addr held[i].cpuData[0]), offset: offset, elements: k.slotSizes[i], allocationElements: held[i].cpuData.len)
                    elif model.arena.cpuData.len > 0:
                        views[i] = CpuVmView(base: cast[ptr float32](addr model.arena.cpuData[0]), offset: offset, elements: k.slotSizes[i], allocationElements: model.arena.cpuData.len)
                    else:
                        return false
            if views[0].base == nil:
                return false
            return cpu_backend.vmRunBound(k.program.words, views, threads, (k.tgBytes+3) div 4, k.tgSize)
        let vk = be == gbVulkan
        var pipelineName = prepared.name
        var pipelineSource = prepared.source
        if vk and prepared.coopTiles.len > 0:
            # Q4 Tensor Core micro-kernel: row tile and grid follow the rows this dispatch runs.
            let shape = q4CoopShape(k.program)
            let rows = if model.activeRows > 0: min(shape.M, model.activeRows) else: shape.M
            let tile = fgQ4CoopTile(model, rows, shape.N)
            let index = prepared.coopTiles.find(tile)
            if index < 0:
                return false
            pipelineName = prepared.coopNames[index]
            pipelineSource = prepared.coopSources[index]
            threads = ((rows + tile - 1) div tile) * ((shape.N + 63) div 64) * k.tgSize
        elif vk and prepared.gemvRows > 0:
            # Q4 subgroup GEMV micro-kernel: one workgroup per ROWS*tg/32 output rows of each activation row.
            let shape = q4GemvShape(k.program)
            let rows = if model.activeRows > 0: min(shape.M, model.activeRows) else: shape.M
            threads = q4GemvThreadCount(rows, shape.N, prepared.gemvRows, k.tgSize)
        if not sessionEncPipeline(vk, pipelineName, pipelineSource):
            return false
        for i in 0 .. 4:
            if k.slotBuffers[i].len == 0:
                continue
            let slot = if vk: i else: i+1
            let handle = fgPortHandle(model, k.slotBuffers[i], layer)
            let offset = if k.slotAnchor[i] >= 0: k.slotAnchor[i] else: fgPortOffset(model, k.slotBuffers[i], layer)
            if vk and i in [1, 3] and offset mod 4 != 0 and (prepared.coopTiles.len > 0 or prepared.gemvRows > 0):
                # These shaders read the weights as uvec4 and the activations as vec4.
                raise newException(ValueError, "FIR Q4 micro-kernel " & node.op & ": " & k.slotBuffers[i] & " starts at float " & $offset & ", not on a 16-byte boundary")
            if not sessionEncBindVkOrMetal(vk, slot, handle.metalHandle, handle.vulkanHandle, offset):
                return false
        if not sessionEncTgBytes(vk, 0, k.tgBytes):
            return false
        return sessionEncDispatch(vk, threads, k.tgSize, k.tgBytes)
    if be == gbCpu and prepared.cpuFn != nil and not model.useHandles and cpuJitRun(prepared.cpuFn, model.arena.cpuData, threads, k.tgSize):
        return true
    if prepared.stage.len == 0:
        return fgDispatchArena(model, prepared, false, threads)
    # Handle graph: copy the ports into the staging arena, run the kernel there, copy the outputs back.
    for port in prepared.stage:
        if port.reads and not sessionCopyInto(be, fgPortHandle(model, port.name), model.stage, fgPortOffset(model, port.name), port.offset, port.elements):
            return false
    result = fgDispatchArena(model, prepared, true, threads)
    if result:
        for port in prepared.stage:
            if port.writes:
                let index = fgPortHandleIndex(model, port.name)
                if index < 0 or not sessionCopyInto(be, model.stage, model.handles[index], port.offset, fgPortOffset(model, port.name), port.elements):
                    return false

function fgEncodeMicro(model: var FirGraph, prepared: FgResidentProgram, node: FirNode, layer: int): bool
    fgEncodeMicroBody(model, prepared, node, layer)

function fgAttrTable(text: string): Table[string, string]
    result = initTable[string, string]()
    for item in text.split(','):
        let eq = item.find('=')
        if eq > 0:
            result[item[0 ..< eq]] = item[eq+1 .. ^1]

function fgAttrInt(table: Table[string, string], key: string, fallback: int): int
    if table.hasKey(key):
        return parseInt(table[key])
    return fallback

function fgAttrBits(table: Table[string, string], key: string, fallback: float32): float32
    if not table.hasKey(key):
        return fallback
    let value = table[key]
    if value.len == 9 and value[0] == 'h':
        return cast[float32](uint32(parseHexInt(value[1 .. ^1])))
    float32(parseFloat(value))

function fgCopySourceOffset(model: FirGraph, attrs: Table[string, string], n: int): int
    ## srcOff of a replayed copy. lastRowOf=R: the source holds R rows of n floats and the copy
    ## takes the last one, or the last row a partial phase run really computed.
    result = fgAttrInt(attrs, "srcOff", 0)
    let rows = fgAttrInt(attrs, "lastRowOf", 0)
    if rows > 0:
        let active = if model.activeRows > 0: min(rows, model.activeRows) else: rows
        result += (active-1)*n

function fgEncodeNativeQ4(model: var FirGraph, node: FirNode, layer: int): bool
    let weightName = fgNativeQ4Weight(model.graph, node)
    if weightName.len == 0:
        return false
    let ins = node.inputs.splitWhitespace()
    let outs = node.outputs.splitWhitespace()
    if ins.len != 2 or outs.len != 1:
        raise newException(ValueError, "FIR native Q4 kernel needs one activation, one weight and one output: " & node.name)
    let inputName = if ins[0] == weightName: ins[1] else: ins[0]
    let outputName = outs[0]
    let weight = model.graph.buffers[weightName]
    let input = model.graph.buffers[inputName]
    let output = model.graph.buffers[outputName]
    let tensor = fgTensorName(weight, layer)
    if not model.q4.hasKey(tensor):
        raise newException(ValueError, "FIR native Q4 weight was not loaded: " & tensor)
    let q4 = model.q4[tensor]
    if q4.k <= 0 or input.elements mod q4.k != 0:
        raise newException(ValueError, "FIR native Q4 input shape mismatch: " & node.name)
    let fullRows = input.elements div q4.k
    let rows = if model.activeRows > 0: min(fullRows, model.activeRows) else: fullRows
    let count = rows*q4.n
    if rows <= 0 or count > output.elements:
        raise newException(ValueError, "FIR native Q4 output shape mismatch: " & node.name)

    let be = model.backend.kind.toByby()
    let source = fgPortHandle(model, inputName, layer)
    let sourceOffset = fgPortOffset(model, inputName, layer)
    let sourceIndex = fgPortHandleIndex(model, inputName, layer)
    let targetIndex = fgPortHandleIndex(model, outputName, layer)
    let targetOffset = fgPortOffset(model, outputName, layer)
    # In data graphs, activations already have one handle each. Dispatch straight
    # into the output handle, exactly as the native runner does, when the ports
    # are whole buffers and do not alias.
    if sourceIndex >= 0 and targetIndex >= 0 and sourceIndex != targetIndex and
        sourceOffset == 0 and targetOffset == 0:
        var target = model.handles[targetIndex]
        if not sessionMatmulQ4(be, source, q4, target, rows):
            return false
        model.handles[targetIndex] = target
        return true

    if not sessionCopyInto(be, source, model.linearInput, sourceOffset, 0, rows*q4.k):
        return false
    var target = model.linearOutput
    if not sessionMatmulQ4(be, model.linearInput, q4, target, rows):
        return false
    model.linearOutput = target
    if targetIndex >= 0:
        return sessionCopyInto(be, target, model.handles[targetIndex], 0, targetOffset, count)
    sessionCopyInto(be, target, model.arena, 0, model.bindings.memory[outputName], count)

function fgEncodeSessionHandles(model: var FirGraph, node: FirNode, layer: int): bool
    let be = model.backend.kind.toByby()
    let ins = node.inputs.splitWhitespace()
    let outs = node.outputs.splitWhitespace()
    let colon = node.op.find(':')
    let name = if colon >= 0: node.op[0 ..< colon] else: node.op
    var attrs = initTable[string, string]()
    if colon >= 0:
        attrs = fgAttrTable(node.op[colon+1 .. ^1])
    if name == "sessionRmsnormEnc":
        let n = fgAttrInt(attrs, "cols", 0)
        if n <= 0:
            return false
        let count = n*fgAttrInt(attrs, "rows", 1)
        let source = fgPortHandle(model, ins[0])
        let sourceOffset = fgPortOffset(model, ins[0])
        let gamma = fgPortHandle(model, ins[1])
        let gammaOffset = fgPortOffset(model, ins[1])
        if not sessionCopyInto(be, source, model.scratchA, sourceOffset, 0, count):
            return false
        if not sessionCopyInto(be, gamma, model.scratchB, gammaOffset, 0, n):
            return false
        var y = model.scratchC
        if not sessionRmsnormEnc(be, model.scratchA, model.scratchB, y,
            fgAttrInt(attrs, "rows", 1), n, fgAttrBits(attrs, "eps", 1e-5'f32)):
            return false
        model.scratchC = y
        let targetIndex = fgPortHandleIndex(model, outs[0])
        let targetOffset = fgPortOffset(model, outs[0])
        if targetIndex < 0:
            return false
        return sessionCopyInto(be, model.scratchC, model.handles[targetIndex], 0, targetOffset, count)
    if name == "sessionVecOp":
        let n = fgAttrInt(attrs, "n", 0)
        if n <= 0 or not attrs.hasKey("op"):
            return false
        let a = fgPortHandle(model, ins[0])
        let aOffset = fgPortOffset(model, ins[0])
        let b = fgPortHandle(model, ins[1])
        let bOffset = fgPortOffset(model, ins[1])
        if not sessionCopyInto(be, a, model.scratchA, aOffset, 0, n):
            return false
        if not sessionCopyInto(be, b, model.scratchB, bOffset, 0, n):
            return false
        var c = model.scratchC
        if not sessionVecOp(be, attrs["op"], model.scratchA, model.scratchB, c, n):
            return false
        model.scratchC = c
        let targetIndex = fgPortHandleIndex(model, outs[0])
        let targetOffset = fgPortOffset(model, outs[0])
        if targetIndex < 0:
            return false
        return sessionCopyInto(be, model.scratchC, model.handles[targetIndex], 0, targetOffset, n)
    if name == "sessionActivation":
        let n = fgAttrInt(attrs, "n", 0)
        if n <= 0 or not attrs.hasKey("op"):
            return false
        let source = fgPortHandle(model, ins[0])
        let sourceOffset = fgPortOffset(model, ins[0])
        if not sessionCopyInto(be, source, model.scratchA, sourceOffset, 0, n):
            return false
        var y = model.scratchC
        if not sessionActivation(be, attrs["op"], model.scratchA, y, n,
            fgAttrBits(attrs, "p", 0'f32)):
            return false
        model.scratchC = y
        let targetIndex = fgPortHandleIndex(model, outs[0])
        let targetOffset = fgPortOffset(model, outs[0])
        if targetIndex < 0:
            return false
        return sessionCopyInto(be, model.scratchC, model.handles[targetIndex], 0, targetOffset, n)
    if name == "sessionCopyInto":
        let n = fgAttrInt(attrs, "n", 0)
        if n <= 0:
            return false
        let source = fgPortHandle(model, ins[0])
        let sourceOffset = fgPortOffset(model, ins[0]) + fgCopySourceOffset(model, attrs, n)
        let targetIndex = fgPortHandleIndex(model, outs[0])
        let targetOffset = fgPortOffset(model, outs[0]) + fgAttrInt(attrs, "dstOff", 0)
        if targetIndex < 0:
            return false
        return sessionCopyInto(be, source, model.handles[targetIndex], sourceOffset, targetOffset, n)
    raise newException(ValueError, "FIR graph unsupported session replay: " & node.op)

function fgEncodeSession(model: var FirGraph, node: FirNode, layer: int): bool
    # Replay a recorded session call on dedicated staging buffers so the backend
    # shader sees the same values as the recorded runtime.
    if model.useHandles:
        return fgEncodeSessionHandles(model, node, layer)
    let be = model.backend.kind.toByby()
    let ins = node.inputs.splitWhitespace()
    let outs = node.outputs.splitWhitespace()
    let colon = node.op.find(':')
    let name = if colon >= 0: node.op[0 ..< colon] else: node.op
    var attrs = initTable[string, string]()
    if colon >= 0:
        attrs = fgAttrTable(node.op[colon+1 .. ^1])
    let memory = fgLayerBindings(model, layer).memory
    if name == "sessionRmsnormEnc":
        let n = fgAttrInt(attrs, "cols", 0)
        if n <= 0:
            return false
        let count = n*fgAttrInt(attrs, "rows", 1)
        if not sessionCopyInto(be, model.arena, model.scratchA, memory[ins[0]], 0, count):
            return false
        if not sessionCopyInto(be, model.arena, model.scratchB, memory[ins[1]], 0, n):
            return false
        var y = model.scratchC
        if not sessionRmsnormEnc(be, model.scratchA, model.scratchB, y,
            fgAttrInt(attrs, "rows", 1), n, fgAttrBits(attrs, "eps", 1e-5'f32)):
            return false
        model.scratchC = y
        return sessionCopyInto(be, model.scratchC, model.arena, 0, memory[outs[0]], count)
    if name == "sessionVecOp":
        let n = fgAttrInt(attrs, "n", 0)
        if n <= 0 or not attrs.hasKey("op"):
            return false
        if not sessionCopyInto(be, model.arena, model.scratchA, memory[ins[0]], 0, n):
            return false
        if not sessionCopyInto(be, model.arena, model.scratchB, memory[ins[1]], 0, n):
            return false
        var c = model.scratchC
        if not sessionVecOp(be, attrs["op"], model.scratchA, model.scratchB, c, n):
            return false
        model.scratchC = c
        return sessionCopyInto(be, model.scratchC, model.arena, 0, memory[outs[0]], n)
    if name == "sessionActivation":
        let n = fgAttrInt(attrs, "n", 0)
        if n <= 0 or not attrs.hasKey("op"):
            return false
        if not sessionCopyInto(be, model.arena, model.scratchA, memory[ins[0]], 0, n):
            return false
        var y = model.scratchC
        if not sessionActivation(be, attrs["op"], model.scratchA, y, n,
            fgAttrBits(attrs, "p", 0'f32)):
            return false
        model.scratchC = y
        return sessionCopyInto(be, model.scratchC, model.arena, 0, memory[outs[0]], n)
    if name == "sessionCopyInto":
        let n = fgAttrInt(attrs, "n", 0)
        if n <= 0:
            return false
        let srcOffset = memory[ins[0]] + fgCopySourceOffset(model, attrs, n)
        let dstOffset = memory[outs[0]] + fgAttrInt(attrs, "dstOff", 0)
        var dst = model.arena
        return sessionCopyInto(be, model.arena, dst, srcOffset, dstOffset, n)
    raise newException(ValueError, "FIR graph unsupported session replay: " & node.op)

function fgEncodeNodeBody(model: var FirGraph, node: FirNode, layer, token: int): bool
    if node.kind == "micro":
        if model.nativeQ4 and fgNativeQ4Weight(model.graph, node).len > 0:
            return fgEncodeNativeQ4(model, node, layer)
        return fgEncodeMicro(model, model.programs[fgNodeKey(node, layer)], node, layer)
    if node.kind == "session":
        return fgEncodeSession(model, node, layer)
    let be = model.backend.kind.toByby()
    let ins = node.inputs.splitWhitespace()
    let output = node.outputs.splitWhitespace()[0]
    let weight = model.graph.buffers[ins[1]]
    let tensor = fgTensorName(weight, layer)
    let bindings = fgLayerBindings(model, layer)
    let n = model.graph.buffers[output].elements
    if node.op == "fir.embedding":
        let role = model.graph.buffers[ins[0]].role
        if role != "token" and role != "position":
            raise newException(ValueError, "FIR graph embedding input needs role token or position: " & ins[0])
        let width = weight.dims[1]
        let rows = n div width
        if rows < 1 or rows*width != n:
            raise newException(ValueError, "FIR graph embedding output is not a whole number of rows: " & output)
        let filled = if model.activeRows > 0: min(rows, model.activeRows) else: rows
        if rows > 1 and (role != "token" or model.chunk.len != filled):
            raise newException(ValueError, "FIR graph multi-row embedding needs a token chunk of " & $filled)
        var targetIndex = 0
        var targetOffset = bindings.memory[output]
        if model.useHandles:
            targetIndex = fgPortHandleIndex(model, output)
            targetOffset = fgPortOffset(model, output)
        if targetIndex < 0:
            return false
        for row in 0 ..< filled:
            var index = token
            if rows > 1:
                index = model.chunk[row]
            elif role != "token":
                index = model.position
            if index < 0 or index >= weight.dims[0]:
                raise newException(ValueError, "FIR graph embedding index outside weight")
            var ok = false
            if model.useHandles:
                ok = sessionCopyInto(be, model.fp32[tensor], model.handles[targetIndex], index*width, targetOffset+row*width, width)
            else:
                ok = sessionCopyInto(be, model.fp32[tensor], model.arena, index*width, targetOffset+row*width, width)
            if not ok:
                return false
        return true
    let k = model.graph.buffers[ins[0]].elements
    if not model.useHandles and weight.dtype == "f32" and (node.op == "fir.linear" or node.op == "fir.linear_t"):
        # MPS reads A and writes C in place inside the arena: no copy in, no copy out.
        let wt = node.op == "fir.linear_t"
        let inner = if wt: weight.dims[1] else: weight.dims[0]
        let rows = k div inner
        let aOff = bindings.memory[ins[0]]
        let cOff = bindings.memory[output]
        if sessionMatmulMps(be, model.arena, model.fp32[tensor], model.arena, rows, inner, n div rows, wt, aOff, cOff):
            return true
    if model.useHandles:
        let source = fgPortHandle(model, ins[0])
        let sourceOffset = fgPortOffset(model, ins[0])
        if not sessionCopyInto(be, source, model.linearInput, sourceOffset, 0, k):
            return false
    elif not sessionCopyInto(be, model.arena, model.linearInput, bindings.memory[ins[0]], 0, k):
        return false
    var ok = false
    case node.op
    of "fir.linear":
        if weight.dtype == "q4":
            ok = sessionMatmulQ4(be, model.linearInput, model.q4[tensor], model.linearOutput, k div weight.dims[0])
        else:
            let inner = weight.dims[0]
            let rows = k div inner
            ok = sessionMatmulMps(be, model.linearInput, model.fp32[tensor], model.linearOutput, rows, inner, n div rows, false)
            if not ok:
                ok = sessionMatmul(be, model.linearInput, model.fp32[tensor], model.linearOutput, rows, inner, n div rows)
    of "fir.linear_t":
        if weight.dtype == "q4t":
            ok = sessionMatmulQ4(be, model.linearInput, model.q4[tensor], model.linearOutput, 1)
        else:
            let inner = weight.dims[1]
            let rows = k div inner
            ok = sessionMatmulMps(be, model.linearInput, model.fp32[tensor], model.linearOutput, rows, inner, n div rows, true)
            if not ok:
                ok = sessionMatmulNT(be, model.linearInput, model.fp32[tensor], model.linearOutput, rows, inner, n div rows)
    else:
        raise newException(ValueError, "FIR graph unsupported resident external: " & node.op)
    if model.useHandles:
        let targetIndex = fgPortHandleIndex(model, output)
        let targetOffset = fgPortOffset(model, output)
        if targetIndex < 0:
            return false
        return ok and sessionCopyInto(be, model.linearOutput, model.handles[targetIndex], 0, targetOffset, n)
    ok and sessionCopyInto(be, model.linearOutput, model.arena, 0, bindings.memory[output], n)

function fgEncodeNode(model: var FirGraph, node: FirNode, layer, token: int): bool
    if not firProbeOn:
        return fgEncodeNodeBody(model, node, layer, token)
    let tag = fgNodeTag(model, node, layer)
    let ins = fgProbePorts(model, node.inputs, layer)
    let outs = fgProbePorts(model, node.outputs, layer)
    var attrs = "kind=" & node.kind & ",name=" & probeQuote(node.name) & ",op=" & probeQuote(node.op) & ",layer=" & $layer & ",repeat=" & (if node.perLayer: "1" else: "0") & fgProbeWeightAttrs(model, node.inputs, layer)
    var prog = "none"
    var impl = "ext:" & node.op
    if node.kind == "micro":
        if model.nativeQ4 and fgNativeQ4Weight(model.graph, node).len > 0:
            impl = "backend.sessionMatmulQ4"
            attrs = attrs & ",q4_backend=native"
        else:
            let prepared = model.programs[fgNodeKey(node, layer)].kernel
            attrs = attrs & ",threads=" & $prepared.threads & ",tg=" & $prepared.tgSize & ",tgbytes=" & $prepared.tgBytes
            prog = probeProgram(prepared.program.words)
            impl = probeProgramImpl(prog)
    let context = probeOpStart("fgEncodeNode", tag, ins, attrs, impl, prog)
    try:
        result = fgEncodeNodeBody(model, node, layer, token)
    finally:
        probeOpFinish(context, outs, "", "")

function firGraphReset(model: var FirGraph)
    if model.failed:
        raise newException(ValueError, "FIR graph model is closed or a prior session failed")
    # Attention overwrites every used KV slot before reading; future slots
    # are unreachable. No cache clear or host transfer is needed.
    let be = model.backend.kind.toByby()
    if model.initialState.len > 0:
        if not sessionBegin(be):
            raise newException(ValueError, "FIR graph state reset session failed")
        try:
            for item in model.initialState:
                let buffer = model.graph.buffers[item.name]
                let data = fgInitValues(model, buffer)
                var source = sessionUpload(be, data)
                try:
                    var ok = false
                    if model.useHandles:
                        let targetIndex = fgPortHandleIndex(model, item.name)
                        let targetOffset = fgPortOffset(model, item.name)
                        if targetIndex < 0:
                            raise newException(ValueError, "FIR graph state reset needs a resident buffer")
                        ok = sessionCopyInto(be, source, model.handles[targetIndex], 0, targetOffset, data.len)
                    else:
                        ok = sessionCopyInto(be, source, model.arena, 0, item.offset, data.len)
                    if not ok:
                        raise newException(ValueError, "FIR graph state reset copy failed")
                finally:
                    sessionFree(be, source)
        finally:
            discard sessionEnd(be)
    model.position = 0

const FgCommitRowNodes = 512              # row-nodes per command buffer inside a multi-row phase

function fgProfileNodes(): bool
    ## BYBY_FIR_PROFILE=2 ends the GPU session after every node and adds the wall time to a
    ## per-kernel total (firGraphProfileReport). The extra waits slow the run; use it only to
    ## see which kernels a phase spends its time in.
    var state {.global.}: int
    if state == 0:
        state = if getEnv("BYBY_FIR_PROFILE", "0") == "2": 2 else: 1
    result = state == 2

function fgProfileNode(model: var FirGraph, node: FirNode, phase: string, startedAt: float)
    let be = model.backend.kind.toByby()
    if not sessionEnd(be) or not sessionBegin(be):
        raise newException(ValueError, "FIR graph profile session failed")
    let colon = node.op.find(':')
    let key = (if phase.len > 0: phase else: "decode") & " " & (if colon >= 0: node.op[0 ..< colon] else: node.op)
    model.profTime[key] = model.profTime.getOrDefault(key, 0.0) + epochTime()-startedAt
    model.profCount[key] = model.profCount.getOrDefault(key, 0) + 1

function firGraphProfileReport(model: FirGraph): seq[string]
    ## One line per (phase, kernel): runs, total and mean wall time, from BYBY_FIR_PROFILE=2.
    for key, seconds in model.profTime:
        let runs = model.profCount[key]
        result.add(key & ": " & $runs & " runs, " & formatFloat(seconds*1000, ffDecimal, 1) & " ms total, " & formatFloat(seconds*1000/float(runs), ffDecimal, 3) & " ms each")
    result.sort()

function fgEncodeGraph(model: var FirGraph, token: int, phase: string)
    # Encode every node of one phase ("" = decode step, else a named multi-row phase) in file order.
    let profileNodes = fgProfileNodes()
    # A multi-row phase is too long for one command buffer on GPUs that pace them (the driver
    # cancels a buffer that runs for seconds): commit and keep encoding, without waiting, every
    # FgCommitRowNodes row-nodes (nodes times the rows this run covers), like the native prefill.
    let be = model.backend.kind.toByby()
    let paced = phase.len > 0 and sessionPacesCommandBuffers(be)
    let runRows = if model.activeRows > 0: model.activeRows elif phase.len > 0: model.graph.phases[phase] else: 1
    var pendingRows = 0
    var index = 0
    while index < model.graph.nodes.len:
        if model.graph.nodes[index].phase != phase:
            inc index
            continue
        if model.graph.nodes[index].perLayer:
            var stop = index
            while stop < model.graph.nodes.len and model.graph.nodes[stop].perLayer and model.graph.nodes[stop].phase == phase:
                inc stop
            for layer in 0 ..< model.graph.symbols["layers"]:
                for i in index ..< stop:
                    let node = model.graph.nodes[i]
                    let nodeStart = if profileNodes: epochTime() else: 0.0
                    if not fgEncodeNode(model, node, layer, token):
                        raise newException(ValueError, "FIR graph resident encode failed: " & node.name & (if cpu_backend.cpuLastErrorMessage().len > 0: " (" & cpu_backend.cpuLastErrorMessage() & ")" else: ""))
                    if profileNodes:
                        fgProfileNode(model, node, phase, nodeStart)
                    elif paced:
                        pendingRows += runRows
                        if pendingRows >= FgCommitRowNodes:
                            if not sessionCommitContinue(be):
                                raise newException(ValueError, "FIR graph commit failed in phase " & phase)
                            pendingRows = 0
            index = stop
        else:
            let node = model.graph.nodes[index]
            let nodeStart = if profileNodes: epochTime() else: 0.0
            if not fgEncodeNode(model, node, 0, token):
                raise newException(ValueError, "FIR graph resident encode failed: " & node.name & (if cpu_backend.cpuLastErrorMessage().len > 0: " (" & cpu_backend.cpuLastErrorMessage() & ")" else: ""))
            if profileNodes:
                fgProfileNode(model, node, phase, nodeStart)
            elif paced:
                pendingRows += runRows
                if pendingRows >= FgCommitRowNodes:
                    if not sessionCommitContinue(be):
                        raise newException(ValueError, "FIR graph commit failed in phase " & phase)
                    pendingRows = 0
            inc index

function fgProfileOn(): bool
    ## BYBY_FIR_PROFILE=1 adds up, per decode step, the host encode time, the GPU wait and the
    ## logits read, to tell GPU-bound steps from host-bound ones (the BYBY_M3_PROFILE split).
    var state {.global.}: int
    if state == 0:
        state = if getEnv("BYBY_FIR_PROFILE", "0") == "1": 2 else: 1
    result = state == 2

function firGraphStep(model: var FirGraph, token: int, stepKind = "decode"): seq[float32]
    if model.failed:
        raise newException(ValueError, "FIR graph model is closed or a prior session failed")
    if token < 0 or token >= model.graph.symbols["vocab"]:
        raise newException(ValueError, "FIR graph token outside vocabulary")
    if model.position >= model.graph.symbols["positions"]:
        raise newException(ValueError, "FIR graph context exceeds n_positions")
    let be = model.backend.kind.toByby()
    if unlikely(firProbeOn):
        probeStepBegin(stepKind, model.position, model.position, token)
    defer:
        if unlikely(firProbeOn):
            probeStepEnd()
    let profile = fgProfileOn()
    let startedAt = if profile: epochTime() else: 0.0
    var encodedAt = 0.0
    var waitedAt = 0.0
    # Two scalar inputs are the only per-token host upload. All weights,
    # scratch, activations and KV remain allocated across sessions.
    var scalars = sessionUpload(be, @[float32(token), float32(model.position)])
    probeRole(scalars, "token", 0, 4)
    probeRole(scalars, "position", 4, 4)
    probeRoleScalar(scalars, "token", 0, token)
    probeRoleScalar(scalars, "position", 4, model.position)
    if not sessionBegin(be):
        sessionFree(be, scalars)
        raise newException(ValueError, "FIR graph sessionBegin failed")
    inc model.sessions
    var ended = false
    try:
        if model.useHandles:
            let tokenName = firRoleBuffer(model.graph, "token")
            let positionName = firRoleBuffer(model.graph, "position")
            let tokenIndex = fgPortHandleIndex(model, tokenName)
            let tokenOffset = fgPortOffset(model, tokenName)
            let positionIndex = fgPortHandleIndex(model, positionName)
            let positionOffset = fgPortOffset(model, positionName)
            if tokenIndex < 0 or positionIndex < 0:
                raise newException(ValueError, "FIR graph scalar input needs resident buffers")
            if not sessionCopyInto(be, scalars, model.handles[tokenIndex], 0, tokenOffset, 1) or not sessionCopyInto(be, scalars, model.handles[positionIndex], 1, positionOffset, 1):
                raise newException(ValueError, "FIR graph scalar input encode failed")
        elif not sessionCopyInto(be, scalars, model.arena, 0, model.bindings.memory[firRoleBuffer(model.graph, "token")], 1) or not sessionCopyInto(be, scalars, model.arena, 1, model.bindings.memory[firRoleBuffer(model.graph, "position")], 1):
            raise newException(ValueError, "FIR graph scalar input encode failed")
        fgEncodeGraph(model, token, "")
        let logitsName = firRoleBuffer(model.graph, "logits")
        if model.useHandles:
            let logitsIndex = fgPortHandleIndex(model, logitsName)
            let logitsOffset = fgPortOffset(model, logitsName)
            if logitsIndex < 0:
                raise newException(ValueError, "FIR graph logits needs a resident buffer")
            if not sessionCopyInto(be, model.handles[logitsIndex], model.logitsReadback, logitsOffset, 0, model.graph.symbols["vocab"]):
                raise newException(ValueError, "FIR graph logits encode failed")
        elif not sessionCopyInto(be, model.arena, model.logitsReadback, model.bindings.memory[logitsName], 0, model.graph.symbols["vocab"]):
            raise newException(ValueError, "FIR graph logits encode failed")
        if profile:
            encodedAt = epochTime()
        ended = true
        if not sessionEnd(be):
            raise newException(ValueError, "FIR graph sessionEnd failed")
        if profile:
            waitedAt = epochTime()
        result = sessionRead(be, model.logitsReadback, model.graph.symbols["vocab"])
        if result.len != model.graph.symbols["vocab"]:
            raise newException(ValueError, "FIR graph logits read length mismatch")
        if profile:
            let doneAt = epochTime()
            model.stepEncodeSeconds += encodedAt-startedAt
            model.stepWaitSeconds += waitedAt-encodedAt
            model.stepReadSeconds += doneAt-waitedAt
            inc model.stepProfiled
        inc model.logitsReads
        inc model.position
    except:
        model.failed = true
        raise
    finally:
        if not ended:
            discard sessionEnd(be)
        sessionFree(be, scalars)

function firGraphPhase(model: var FirGraph, phase: string, tokens: seq[int]): seq[float32]
    # Run one named multi-row phase over `rows` tokens. It updates model state; a phase that
    # declares `logits=BUFFER` also returns rows*vocab floats, otherwise the result is empty.
    # A phase declared `partial` also takes fewer tokens (the tail of a prompt): only the threads
    # of those rows are launched.
    if model.failed:
        raise newException(ValueError, "FIR graph model is closed or a prior session failed")
    if not model.graph.phases.hasKey(phase) or tokens.len < 1 or tokens.len > model.graph.phases[phase] or (tokens.len < model.graph.phases[phase] and phase notin model.graph.phasePartial):
        raise newException(ValueError, "FIR graph phase " & phase & " does not take " & $tokens.len & " rows")
    for token in tokens:
        if token < 0 or token >= model.graph.symbols["vocab"]:
            raise newException(ValueError, "FIR graph token outside vocabulary")
    if model.position+tokens.len > model.graph.symbols["positions"]:
        raise newException(ValueError, "FIR graph context exceeds n_positions")
    let be = model.backend.kind.toByby()
    var scalars = sessionUpload(be, @[float32(tokens[0]), float32(model.position)])
    if not sessionBegin(be):
        sessionFree(be, scalars)
        raise newException(ValueError, "FIR graph sessionBegin failed")
    inc model.sessions
    var ended = false
    try:
        let tokenName = firRoleBuffer(model.graph, "token")
        let positionName = firRoleBuffer(model.graph, "position")
        if model.useHandles:
            let tokenIndex = fgPortHandleIndex(model, tokenName)
            let positionIndex = fgPortHandleIndex(model, positionName)
            if tokenIndex < 0 or positionIndex < 0:
                raise newException(ValueError, "FIR graph scalar input needs resident buffers")
            if not sessionCopyInto(be, scalars, model.handles[tokenIndex], 0, fgPortOffset(model, tokenName), 1) or not sessionCopyInto(be, scalars, model.handles[positionIndex], 1, fgPortOffset(model, positionName), 1):
                raise newException(ValueError, "FIR graph scalar input encode failed")
        elif not sessionCopyInto(be, scalars, model.arena, 0, model.bindings.memory[tokenName], 1) or not sessionCopyInto(be, scalars, model.arena, 1, model.bindings.memory[positionName], 1):
            raise newException(ValueError, "FIR graph scalar input encode failed")
        model.chunk = tokens
        model.activeRows = if tokens.len < model.graph.phases[phase]: tokens.len else: 0
        try:
            fgEncodeGraph(model, tokens[0], phase)
        finally:
            model.chunk = @[]
            model.activeRows = 0
        var count = 0
        if model.graph.phaseLogits.hasKey(phase) or model.graph.phaseLast.hasKey(phase):
            let name = if model.graph.phaseLogits.hasKey(phase): model.graph.phaseLogits[phase] else: model.graph.phaseLast[phase]
            count = model.graph.buffers[name].elements
            var copied = false
            if model.useHandles:
                let index = fgPortHandleIndex(model, name)
                if index < 0:
                    raise newException(ValueError, "FIR graph phase logits needs a resident buffer")
                copied = sessionCopyInto(be, model.handles[index], model.phaseReadback, fgPortOffset(model, name), 0, count)
            else:
                copied = sessionCopyInto(be, model.arena, model.phaseReadback, model.bindings.memory[name], 0, count)
            if not copied:
                raise newException(ValueError, "FIR graph phase logits encode failed")
        ended = true
        if not sessionEnd(be):
            raise newException(ValueError, "FIR graph sessionEnd failed")
        if count > 0:
            result = sessionRead(be, model.phaseReadback, count)
            if result.len != count:
                raise newException(ValueError, "FIR graph phase logits read length mismatch")
        model.position += tokens.len
    except:
        model.failed = true
        raise
    finally:
        if not ended:
            discard sessionEnd(be)
        sessionFree(be, scalars)
