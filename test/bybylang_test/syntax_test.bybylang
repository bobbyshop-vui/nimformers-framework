# BybyLang syntax test: functions with parameters, Nim statements that own a
# block, field/index/compound assignments and blank lines inside blocks.

import nim "std/tables"

type
  Point = object
    x, y: int
  Shape = enum
    shCircle = "circle",
    shSquare = "square"

const Scale = 3

function scaled(p: Point, k: int): Point
    result = p
    result.x = p.x * k

    result.y = p.y * k

function describe(s: Shape): string
    case s
    of shCircle:
        result = "circle"
    of shSquare:
        result = "square"

function sumTo(n: int): int
    var total = 0
    for i in 1 .. n:
        total += i
    # a comment at column 0 inside the body
# must not end the block
    result = total

function safeParse(s: string): int
    try:
        result = parseInt(s)
    except ValueError:
        result = -1

function stopFlag(): ptr bool
    var flag {.global.}: bool
    result = addr flag

p = Point(x: 1, y: 2)
q = scaled(p, Scale)
if q.x != 3 or q.y != 6:
    print "FAIL scaled: " & $q
    quit(1)
counts = initTable[string, int]()
counts["a"] = 1
counts["a"] += 2
if counts["a"] != 3:
    print "FAIL table assign: " & $counts
    quit(1)
xs = @[0, 0, 0]
xs[1] = 5

xs[2] = xs[1] + 1
if xs != @[0, 5, 6]:
    print "FAIL index assign: " & $xs
    quit(1)
if describe(shSquare) != $shSquare or sumTo(4) != 10:
    print "FAIL case/for"
    quit(1)
if safeParse("12") != 12 or safeParse("x") != -1:
    print "FAIL try/except"
    quit(1)
stopFlag()[] = true
if not stopFlag()[]:
    print "FAIL global flag"
    quit(1)
print "PASS syntax: functions with params, field/index/compound assignment, blank lines"
